---
// Franja de beneficios operativos (Épica 08 · Iteración 06). Estaba repetida idéntica en Servicios, Suscripción Floral y
// Galería, por eso no recibe propiedades. El comentario «2. FRANJA DE BENEFICIOS…» se queda en cada página: Astro lo
// conserva dentro de <main> (Servicios) y lo omite en la ranura antes-del-footer (Suscripción y Galería).
---

<section class="w-full py-space-8 lg:py-space-10">
    <div class="max-w-[80rem] mx-auto px-margin-mobile lg:px-margin-desktop">

        <!-- CONTENEDOR PRINCIPAL: isolate + Gradient + Relative + Overflow Hidden + Shadow XL -->
        <div class="relative isolate overflow-hidden bg-gradient-to-br from-primary to-primary-container dark:to-primary-fixed text-on-primary rounded-xl p-space-6 lg:p-space-8 shadow-xl">

            <!-- CAPA DE TEXTURA SVG (Ruido Fractal Codificado en Base64 idéntico al index.html) -->
            <div class="absolute inset-0 opacity-20 mix-blend-overlay pointer-events-none bg-noise"
                 aria-hidden="true">
            </div>

            <!-- CONTENIDO EN REJILLA DE 2 COLUMNAS (z-10 sobre la textura) -->
            <div class="relative z-10 grid grid-cols-1 md:grid-cols-2 gap-space-6 md:gap-space-8 md:divide-x md:divide-white/15 md:dark:divide-on-primary-fixed/15 items-center">

                <!-- Beneficio 1: Delivery -->
                <div class="flex items-start gap-space-4">
                    <!-- Medallón Glassmorphism idéntico a los botones del index -->
                    <div class="w-14 h-14 rounded-xl bg-surface-container-lowest/20 dark:bg-on-primary-fixed/15 backdrop-blur-md flex items-center justify-center text-neutral-50 dark:text-on-primary-fixed shrink-0 shadow-md border border-white/20 dark:border-on-primary-fixed/20">
                        <svg class="w-7 h-7" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
                        </svg>
                    </div>
                    <div class="flex flex-col">
                        <!-- Píldora de microetiqueta idéntica al index -->
                        <div class="inline-flex items-center gap-2 px-3 py-0.5 rounded-full bg-surface-container-lowest/15 dark:bg-on-primary-fixed/10 backdrop-blur-sm text-neutral-50 dark:text-on-primary-fixed font-label-sm text-[11px] uppercase tracking-widest mb-1.5 w-fit">
                            <span>Valdivia Urbano</span>
                        </div>
                        <h3 class="font-headline-md text-headline-sm lg:text-headline-md text-neutral-50 dark:text-on-primary-fixed leading-snug mb-1">
                            Despacho sin costo
                        </h3>
                        <p class="font-body-sm text-body-sm text-neutral-100 dark:text-on-primary-fixed-variant font-light leading-relaxed">
                            Entregas sin costo adicional en el día, horario hábil y dentro de todo el radio urbano.
                        </p>
                    </div>
                </div>

                <!-- Beneficio 2: Boleta o Factura -->
                <div class="flex items-start gap-space-4 md:pl-space-8">
                    <!-- Medallón Glassmorphism -->
                    <div class="w-14 h-14 rounded-xl bg-surface-container-lowest/20 dark:bg-on-primary-fixed/15 backdrop-blur-md flex items-center justify-center text-neutral-50 dark:text-on-primary-fixed shrink-0 shadow-md border border-white/20 dark:border-on-primary-fixed/20">
                        <svg class="w-7 h-7" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="M19.5 3.5L18 2l-1.5 1.5L15 2l-1.5 1.5L12 2l-1.5 1.5L9 2 7.5 3.5 6 2v14H3v3c0 1.66 1.34 3 3 3h12c1.66 0 3-1.34 3-3V2l-1.5 1.5zM19 19c0 .55-.45 1-1 1s-1-.45-1-1v-1h2v1zm0-3.5h-4V5h4v10.5zM7 7h6v2H7V7zm0 4h6v2H7v-2zm0 4h4v2H7v-2z"/>
                        </svg>
                    </div>
                    <div class="flex flex-col">
                        <!-- Píldora de microetiqueta -->
                        <div class="inline-flex items-center gap-2 px-3 py-0.5 rounded-full bg-surface-container-lowest/15 dark:bg-on-primary-fixed/10 backdrop-blur-sm text-neutral-50 dark:text-on-primary-fixed font-label-sm text-[11px] uppercase tracking-widest mb-1.5 w-fit">
                            <span>Compra Segura</span>
                        </div>
                        <h3 class="font-headline-md text-headline-sm lg:text-headline-md text-neutral-50 dark:text-on-primary-fixed leading-snug mb-1">
                            Respaldo Tributario
                        </h3>
                        <p class="font-body-sm text-body-sm text-neutral-100 dark:text-on-primary-fixed-variant font-light leading-relaxed">
                            Todos nuestros arreglos florales y servicios se comercializan con boleta o factura formal.
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

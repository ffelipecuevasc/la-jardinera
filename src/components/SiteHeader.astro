---
// Header único del sitio (Épica 08 · Iteración 04). Devuelve DOS nodos hermanos: el <header> y, justo después,
// #mobile-menu-scrim (AGENTS.md §5, regla 7: la capa tenue nunca es descendiente del header). Los enlaces de la barra y
// del panel móvil salen de NAVEGACION (src/data/navegacion.js).
// paginaActiva: clave de la página en curso ('inicio' | 'servicios' | 'suscripcion-floral' | 'galeria' | 'contacto') o
// null en la 404, donde ningún enlace queda activo.
import { NAVEGACION } from '../data/navegacion.js';

const { paginaActiva = null } = Astro.props;
---

<header class="fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(53,54,58,0.06)]">
    <div class="h-20 max-w-[80rem] mx-auto px-margin-mobile lg:px-margin-desktop flex items-center justify-between">
        <!-- Logotipo - PNG & TEXTO -->
        <div class="flex items-center">
            <a class="flex items-center gap-3 sm:gap-4 group" data-path="inicio" href="/">
                <!-- Logotipo PNG — variante original (modo claro) -->
                <img src="/logos/la-jardinera-original.png"
                     alt="Logotipo La Jardinera"
                     class="h-11 w-auto shrink-0 object-contain transition-transform duration-300 group-hover:scale-105 block dark:hidden"
                     width="44"
                     height="44"/>
                <!-- Logotipo PNG — variante blanca (modo oscuro) -->
                <img src="/logos/la-jardinera-blanco.png"
                     alt="Logotipo La Jardinera"
                     class="h-11 w-auto shrink-0 object-contain transition-transform duration-300 group-hover:scale-105 hidden dark:block"
                     width="44"
                     height="44"/>
                <!-- Separador Vertical Elegante (solo desde sm) -->
                <div class="hidden sm:block w-px h-8 bg-outline-variant/60 group-hover:bg-primary/40 transition-colors duration-300" aria-hidden="true"></div>
                <!-- Texto del Logotipo (una sola línea: 18px en móvil, 24px desde sm) -->
                <span class="font-headline-md text-headline-sm sm:text-headline-md italic tracking-tight whitespace-nowrap fx-spotlight">
                    La Jardinera
                </span>
            </a>
        </div>
        <!-- Barra de Navegación -->
        <nav
                class="hidden lg:flex items-center gap-1"
                data-active-classes="text-primary"
                aria-label="Navegación principal"
        >{NAVEGACION.map((item) => (
            <a
            aria-current={item.clave === paginaActiva ? 'page' : undefined}
            class={item.clave === paginaActiva
                ? 'group relative px-2.5 xl:px-4 py-3 font-label-md text-label-md uppercase tracking-[0.1em] xl:tracking-[0.16em] text-primary transition-colors duration-300'
                : 'group relative px-2.5 xl:px-4 py-3 font-label-md text-label-md uppercase tracking-[0.1em] xl:tracking-[0.16em] text-on-surface-variant hover:text-primary transition-colors duration-300'}
            data-path={item.clave}
            href={item.ruta}
            >
            <span>{item.etiqueta}</span>

            <span
                    class={item.clave === paginaActiva
                        ? 'absolute left-2.5 right-2.5 xl:left-4 xl:right-4 bottom-1 h-px bg-primary origin-center scale-x-100 transition-transform duration-300'
                        : 'absolute left-2.5 right-2.5 xl:left-4 xl:right-4 bottom-1 h-px bg-primary origin-center scale-x-0 group-hover:scale-x-100 transition-transform duration-300'}
                    aria-hidden="true"
            ></span>
            </a>
        ))}</nav>
        <!-- Íconos de Redes Sociales -->
        <div class="flex items-center gap-2 lg:gap-2 xl:gap-space-3">
            <!-- Instagram -->
            <a aria-label="Visitar Instagram"
               class="hidden lg:flex w-8 h-8 rounded-full bg-surface-container items-center justify-center text-on-surface-variant hover:text-primary transition-all"
               href="https://www.instagram.com/lajardinera.floreria/" target="_blank" rel="noopener noreferrer">
                <svg class="w-5 h-5" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
                    <path d="M128 23.064c34.177 0 38.225.13 51.722.745c12.48.57 19.258 2.655 23.769 4.408c5.974 2.322 10.238 5.096 14.717 9.575s7.253 8.743 9.575 14.717c1.753 4.511 3.838 11.289 4.408 23.768c.615 13.498.745 17.546.745 51.723s-.13 38.226-.745 51.723c-.57 12.48-2.655 19.257-4.408 23.768c-2.322 5.974-5.096 10.239-9.575 14.718s-8.743 7.253-14.717 9.574c-4.511 1.753-11.289 3.839-23.769 4.408c-13.495.616-17.543.746-51.722.746s-38.228-.13-51.723-.746c-12.48-.57-19.257-2.655-23.768-4.408c-5.974-2.321-10.239-5.095-14.718-9.574c-4.479-4.48-7.253-8.744-9.574-14.718c-1.753-4.51-3.839-11.288-4.408-23.768c-.616-13.497-.746-17.545-.746-51.723s.13-38.225.746-51.722c.57-12.48 2.655-19.258 4.408-23.769c2.321-5.974 5.095-10.238 9.574-14.717c4.48-4.48 8.744-7.253 14.718-9.575c4.51-1.753 11.288-3.838 23.768-4.408c13.497-.615 17.545-.745 51.723-.745M128 0C93.237 0 88.878.147 75.226.77c-13.625.622-22.93 2.786-31.071 5.95c-8.418 3.271-15.556 7.648-22.672 14.764S9.991 35.738 6.72 44.155C3.555 52.297 1.392 61.602.77 75.226C.147 88.878 0 93.237 0 128s.147 39.122.77 52.774c.622 13.625 2.785 22.93 5.95 31.071c3.27 8.417 7.647 15.556 14.763 22.672s14.254 11.492 22.672 14.763c8.142 3.165 17.446 5.328 31.07 5.95c13.653.623 18.012.77 52.775.77s39.122-.147 52.774-.77c13.624-.622 22.929-2.785 31.07-5.95c8.418-3.27 15.556-7.647 22.672-14.763s11.493-14.254 14.764-22.672c3.164-8.142 5.328-17.446 5.95-31.07c.623-13.653.77-18.012.77-52.775s-.147-39.122-.77-52.774c-.622-13.624-2.786-22.929-5.95-31.07c-3.271-8.418-7.648-15.556-14.764-22.672S220.262 9.99 211.845 6.72c-8.142-3.164-17.447-5.328-31.071-5.95C167.122.147 162.763 0 128 0m0 62.27c-36.302 0-65.73 29.43-65.73 65.73s29.428 65.73 65.73 65.73c36.301 0 65.73-29.428 65.73-65.73c0-36.301-29.429-65.73-65.73-65.73m0 108.397c-23.564 0-42.667-19.103-42.667-42.667S104.436 85.333 128 85.333s42.667 19.103 42.667 42.667s-19.103 42.667-42.667 42.667m83.686-110.994c0 8.484-6.876 15.36-15.36 15.36s-15.36-6.876-15.36-15.36s6.877-15.36 15.36-15.36s15.36 6.877 15.36 15.36"/>
                </svg>
            </a>

            <!-- WhatsApp -->
            <a aria-label="Contactar por WhatsApp"
               class="hidden lg:flex w-8 h-8 rounded-full bg-surface-container items-center justify-center text-on-surface-variant hover:text-primary transition-all"
               href="https://wa.me/56997702832" target="_blank" rel="noopener noreferrer">
                <svg class="w-5 h-5" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 258">

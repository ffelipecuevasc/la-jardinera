</header>
<!-- Capa tenue del menú móvil: HERMANA del <header>, jamás dentro de él -->
<div id="mobile-menu-scrim" class="hidden lg:hidden fixed inset-x-0 top-20 bottom-0 z-40 bg-neutral-900/40" aria-hidden="true"></div>

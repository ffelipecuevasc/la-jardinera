---
// Footer único del sitio (Épica 08 · Iteración 03). Sus enlaces salen de NAVEGACION (src/data/navegacion.js).
// paginaActiva: clave de la página en curso ('inicio' | 'servicios' | 'suscripcion-floral' | 'galeria' | 'contacto') o
// null en la 404, donde ningún enlace queda activo. El footer no impone margen externo: lo decide cada página.
import { NAVEGACION } from '../data/navegacion.js';

const { paginaActiva = null } = Astro.props;
---

<footer class="w-full bg-surface-container-low border-t border-outline-variant/20">
    <div class="max-w-[80rem] mx-auto px-margin-mobile lg:px-margin-desktop py-space-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-space-6">
            <div class="flex flex-col gap-space-2"><a
                    class="font-headline-md text-headline-md italic tracking-tight text-on-surface" data-path="inicio"
                    href="/">La Jardinera</a>
                <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                    Es increíble el efecto que generan las flores cuando las ves, cuando las arreglas, cuando las
                    recibes, cuando las regalas.
                </p>
                <span class="font-body-xs text-body-xs text-on-surface-variant pt-space-2">
                    © 2026 Desarrollado por
                    <a href="https://felipecuevas.dev" target="_blank" rel="noopener noreferrer"
                    class="text-primary font-semibold hover:underline underline-offset-2 transition-colors">
                        Felipe Cuevas
                    </a>.
                </span>
            </div>
            <div class="flex flex-col gap-space-2"><h3
                    class="font-label-md text-label-md uppercase tracking-wider text-on-surface font-semibold">
                Navegación</h3>
                <nav class="flex flex-col gap-space-1" data-active-classes="text-primary font-semibold">{NAVEGACION.map((item) => (
                    <a aria-current={item.clave === paginaActiva ? 'page' : undefined}
                       class={item.clave === paginaActiva
                           ? 'font-body-sm text-body-sm transition-colors text-primary font-semibold'
                           : 'font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors'}
                       data-path={item.clave} href={item.ruta}>{item.etiqueta}</a>
                ))}</nav>
            </div>
            <!-- COLUMNA 3: Contacto y RRSS -->
            <div class="flex flex-col gap-space-2">
                <h3 class="font-label-md text-label-md uppercase tracking-wider text-on-surface font-semibold">Contacto
                    y RRSS</h3>
                <div class="flex flex-col gap-space-2 font-body-sm text-body-sm text-on-surface-variant mt-1">
                    <!-- Teléfono -->
                    <a href="tel:+56997702832"
                       class="flex items-center gap-space-2 hover:text-primary transition-colors group">
                        <svg class="text-[18px] text-primary flex-shrink-0 group-hover:text-primary transition-colors"
                             fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                             viewBox="0 0 24 24">
                            <path d="M6.54 5c.06.89.21 1.76.45 2.59l-1.2 1.2c-.41-1.2-.67-2.47-.76-3.79h1.51m9.86 12.02c.85.24 1.72.39 2.6.45v1.49c-1.32-.09-2.59-.35-3.8-.75l1.2-1.19M7.5 3H4c-.55 0-1 .45-1 1 0 9.39 7.61 17 17 17 .55 0 1-.45 1-1v-3.49c0-.55-.45-1-1-1-1.24 0-2.45-.2-3.57-.57a.84.84 0 0 0-.31-.05c-.26 0-.51.1-.71.29l-2.2 2.2a15.149 15.149 0 0 1-6.59-6.59l2.2-2.2c.28-.28.36-.67.25-1.02A11.36 11.36 0 0 1 8.5 4c0-.55-.45-1-1-1z"/>
                        </svg>
                        <span>+56 9 9770 2832</span>
                    </a>
                    <!-- Email -->
                    <a href="mailto:lajardinera.floreria@gmail.com"
                       class="flex items-center gap-space-2 hover:text-primary transition-colors group">
                        <svg class="text-[18px] text-primary flex-shrink-0 group-hover:text-primary transition-colors"
                             fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                             viewBox="0 0 24 24">
                            <path d="M22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6zm-2 0-8 4.99L4 6h16zm0 12H4V8l8 5 8-5v10z"/>
                        </svg>
                        <span>lajardinera.floreria@gmail.com</span>
                    </a>
                    <!-- Ubicación -->
                    <a href="https://maps.app.goo.gl/6MEogkfQudDzY4G47" target="_blank" rel="noopener noreferrer"
                       class="flex items-center gap-space-2 hover:text-primary transition-colors group">
                        <svg class="text-[18px] text-primary flex-shrink-0 group-hover:text-primary transition-colors"
                             fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                             viewBox="0 0 24 24">
                            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zM7 9c0-2.76 2.24-5 5-5s5 2.24 5 5c0 2.88-2.88 7.19-5 9.88C9.92 16.21 7 11.85 7 9z"/>
                            <circle cx="12" cy="9" r="2.5"/>
                        </svg>
                        <span>Valdivia, Chile</span>
                    </a>
                </div>
                <!-- Botones Sociales -->
                <div class="flex items-center gap-space-2 pt-space-2">
                    <a aria-label="Instagram" href="https://www.instagram.com/lajardinera.floreria/" target="_blank"
                       rel="noopener noreferrer"
                       class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant hover:text-primary transition-all">
                        <svg class="text-[16px]" fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="18"
                             height="18" viewBox="0 0 256 256">
                            <path fill="currentColor"
                                  d="M128 23.064c34.177 0 38.225.13 51.722.745c12.48.57 19.258 2.655 23.769 4.408c5.974 2.322 10.238 5.096 14.717 9.575s7.253 8.743 9.575 14.717c1.753 4.511 3.838 11.289 4.408 23.768c.615 13.498.745 17.546.745 51.723s-.13 38.226-.745 51.723c-.57 12.48-2.655 19.257-4.408 23.768c-2.322 5.974-5.096 10.239-9.575 14.718s-8.743 7.253-14.717 9.574c-4.511 1.753-11.289 3.839-23.769 4.408c-13.495.616-17.543.746-51.722.746s-38.228-.13-51.723-.746c-12.48-.57-19.257-2.655-23.768-4.408c-5.974-2.321-10.239-5.095-14.718-9.574c-4.479-4.48-7.253-8.744-9.574-14.718c-1.753-4.51-3.839-11.288-4.408-23.768c-.616-13.497-.746-17.545-.746-51.723s.13-38.225.746-51.722c.57-12.48 2.655-19.258 4.408-23.769c2.321-5.974 5.095-10.238 9.574-14.717c4.48-4.48 8.744-7.253 14.718-9.575c4.51-1.753 11.288-3.838 23.768-4.408c13.497-.615 17.545-.745 51.723-.745M128 0C93.237 0 88.878.147 75.226.77c-13.625.622-22.93 2.786-31.071 5.95c-8.418 3.271-15.556 7.648-22.672 14.764S9.991 35.738 6.72 44.155C3.555 52.297 1.392 61.602.77 75.226C.147 88.878 0 93.237 0 128s.147 39.122.77 52.774c.622 13.625 2.785 22.93 5.95 31.071c3.27 8.417 7.647 15.556 14.763 22.672s14.254 11.492 22.672 14.763c8.142 3.165 17.446 5.328 31.07 5.95c13.653.623 18.012.77 52.775.77s39.122-.147 52.774-.77c13.624-.622 22.929-2.785 31.07-5.95c8.418-3.27 15.556-7.647 22.672-14.763s11.493-14.254 14.764-22.672c3.164-8.142 5.328-17.446 5.95-31.07c.623-13.653.77-18.012.77-52.775s-.147-39.122-.77-52.774c-.622-13.624-2.786-22.929-5.95-31.07c-3.271-8.418-7.648-15.556-14.764-22.672S220.262 9.99 211.845 6.72c-8.142-3.164-17.447-5.328-31.071-5.95C167.122.147 162.763 0 128 0m0 62.27c-36.302 0-65.73 29.43-65.73 65.73s29.428 65.73 65.73 65.73c36.301 0 65.73-29.428 65.73-65.73c0-36.301-29.429-65.73-65.73-65.73m0 108.397c-23.564 0-42.667-19.103-42.667-42.667S104.436 85.333 128 85.333s42.667 19.103 42.667 42.667s-19.103 42.667-42.667 42.667m83.686-110.994c0 8.484-6.876 15.36-15.36 15.36s-15.36-6.876-15.36-15.36s6.877-15.36 15.36-15.36s15.36 6.877 15.36 15.36"/>
                        </svg>
                    </a>
                    <a aria-label="Facebook" href="https://www.facebook.com/floresadomiciliovaldivia/" target="_blank"
                       rel="noopener noreferrer"
                       class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant hover:text-primary transition-all">
                        <svg class="text-[16px]" fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="18"
                             height="18" viewBox="0 0 256 256">
                            <path fill="currentColor"
                                  d="M256 128C256 57.308 198.692 0 128 0S0 57.308 0 128c0 63.888 46.808 116.843 108 126.445V165H75.5v-37H108V99.8c0-32.08 19.11-49.8 48.348-49.8C170.352 50 185 52.5 185 52.5V84h-16.14C152.959 84 148 93.867 148 103.99V128h35.5l-5.675 37H148v89.445c61.192-9.602 108-62.556 108-126.445"/>
                            <path class="fill-surface-container"
                                  d="m177.825 165l5.675-37H148v-24.01C148 93.866 152.959 84 168.86 84H185V52.5S170.352 50 156.347 50C127.11 50 108 67.72 108 99.8V128H75.5v37H108v89.445A129 129 0 0 0 128 256a129 129 0 0 0 20-1.555V165z"/>
                        </svg>
                    </a>
                    <a aria-label="WhatsApp" href="https://wa.me/56997702832" target="_blank" rel="noopener noreferrer"
                       class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant hover:text-primary transition-all">
                        <svg class="text-[16px]" fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="18"
                             height="18" viewBox="0 0 256 258">
                            <path fill="currentColor"
                                  d="M128.534 0c34.098.017 66.102 13.29 90.167 37.383c24.066 24.092 37.312 56.12 37.299 90.174c-.028 69.579-56.076 126.318-125.36 127.446l-2.103.017h-.053c-21.005-.007-41.65-5.194-60.051-15.045l-.86-.466L0 257.233l18.083-66.055C6.93 171.852 1.061 149.922 1.07 127.455C1.098 57.178 58.279 0 128.534 0m.044 21.53c-58.437 0-105.964 47.523-105.987 105.936c-.008 19.712 5.424 38.921 15.719 55.612l.478.769l2.52 4.009l-10.703 39.093l40.097-10.517l3.869 2.294c16.007 9.499 34.32 14.599 53.017 14.764l.905.004h.044c58.392 0 105.918-47.526 105.942-105.943c.01-28.308-10.998-54.927-31.001-74.952s-46.603-31.06-74.9-31.07m-45.17 47.063c2.122 0 4.25.02 6.104.115c1.956.096 4.581-.743 7.165 5.466c.992 2.38 2.5 6.057 4.044 9.813l.331.805c2.485 6.045 4.969 12.072 5.447 13.029c.795 1.593 1.325 3.455.264 5.579c-1.06 2.127-1.593 3.454-3.184 5.316c-1.593 1.858-3.344 4.153-4.777 5.579l-.234.233l-.232.237c-1.42 1.469-2.608 3.153-.93 6.027c1.857 3.19 8.248 13.622 17.716 22.066c12.165 10.85 22.428 14.214 25.613 15.809s5.043 1.328 6.9-.8c1.859-2.124 7.961-9.298 10.085-12.487c2.123-3.188 4.246-2.655 7.166-1.593c1.387.505 5.654 2.511 10.092 4.649l1.38.666c4.443 2.15 8.776 4.288 10.29 5.046c3.185 1.595 5.309 2.392 6.104 3.719c.796 1.33.796 7.705-1.858 15.145s-15.378 14.23-21.497 15.146c-5.487.818-12.43 1.16-20.06-1.262c-4.624-1.47-10.558-3.429-18.157-6.71c-31.948-13.794-52.815-45.966-54.406-48.09l-.108-.144c-1.941-2.594-12.898-17.445-12.898-32.804c0-15.675 8.229-23.38 11.147-26.569c2.92-3.186 6.37-3.986 8.493-3.986"/>
                        </svg>
                    </a>
                </div>
            </div>

            <!-- COLUMNA 4: Medios de Pago -->
            <div class="flex flex-col gap-space-2">
                <h3 class="font-label-md text-label-md uppercase tracking-wider text-on-surface font-semibold">Medios de
                    Pago</h3>
                <p class="font-body-sm text-body-sm text-on-surface-variant">
                    Aceptamos pagos en varios formatos y transferencias bancarias:
                </p>
                <div class="flex flex-col gap-space-1 mt-1">
                    <div class="flex items-center gap-space-2 text-on-surface-variant font-body-sm text-body-sm">
                        <svg class="text-[18px] text-primary flex-shrink-0" fill="currentColor"
                             xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                            <path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/>
                        </svg>
                        <span>Crédito/Débito</span>
                    </div>
                    <div class="flex items-center gap-space-2 text-on-surface-variant font-body-sm text-body-sm">
                        <!-- Icono de Transferencia Bancaria (sync_alt) -->
                        <svg class="text-[18px] text-primary flex-shrink-0" fill="currentColor"
                             xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                            <path d="M22 8l-4-4v3H3v2h15v3l4-4zM2 16l4 4v-3h15v-2H6v-3l-4 4z"/>
                        </svg>
                        <span>Transferencia</span>
                    </div>
                    <div class="flex items-center gap-space-2 text-on-surface-variant font-body-sm text-body-sm">
                        <!-- Icono de Billetes/Efectivo (payments) -->
                        <svg class="text-[18px] text-primary flex-shrink-0" fill="currentColor"
                             xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                            <path d="M19 14V6c0-1.1-.9-2-2-2H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zm-2 0H3V6h14v8zm-7-7c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3zm13 0v11c0 1.1-.9 2-2 2H4v-2h17V7h2z"/>
                        </svg>
                        <span>Efectivo</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>

---
import '../css/input.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SeoHead from '../components/SeoHead.astro';
import { NAVEGACION } from '../data/navegacion.js';

const { title, description, noindex = false, bodyClass, paginaActiva = null } = Astro.props;

// Las páginas indexables toman descripción y ruta canónica de NAVEGACION (fuente única); `description` solo lo pasa la
// página no indexable (404), que no figura en NAVEGACION.
const indexable = !noindex;
const entrada = NAVEGACION.find((e) => e.clave === paginaActiva);
if (indexable && !entrada) {
    throw new Error(`BaseLayout: la página indexable «${title}» no figura en NAVEGACION (paginaActiva = ${paginaActiva}).`);
}
---

<!DOCTYPE html>
<html class="light bg-background text-on-surface" lang="es">
<head>
    <meta charset="utf-8"/>
    <script is:inline>
        // Excepción documentada (decisiones-tecnicas.md, ADR-003): fija el tema antes del primer pintado.
        // Misma regla que setInitialTheme() de src/js/modules/theme.js; no escribe en localStorage.
        (function () {
            let guardado = null;
            try { guardado = localStorage.getItem('theme'); } catch (e) { /* almacenamiento bloqueado: manda el sistema */ }
            const oscuro = guardado === 'dark' || (!guardado && window.matchMedia('(prefers-color-scheme: dark)').matches);
            const clases = document.documentElement.classList;
            clases.remove(oscuro ? 'light' : 'dark');
            clases.add(oscuro ? 'dark' : 'light');
        })();
    </script>
    <title>{title}</title>
    <SeoHead
        title={title}
        description={indexable ? entrada.descripcion : description}
        rutaCanonica={entrada?.ruta}
        indexable={indexable}
    />
    <link rel="icon" type="image/png" href="/logos/la-jardinera-original.png"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <link href="https://fonts.googleapis.com" rel="preconnect"/>
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&amp;family=Noto+Serif:ital,wght@0,400;0,600;1,400;1,600&amp;display=swap"
          rel="stylesheet"/>
</head>
<body class={bodyClass}>
<SiteHeader paginaActiva={paginaActiva} />
<slot />
<slot name="antes-del-footer" />
<SiteFooter paginaActiva={paginaActiva} />
<slot name="tras-footer" />
<script src="../js/main.js"></script>
</body>
</html>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="Contacto - La Jardinera Florería"
    bodyClass="bg-background font-body-md text-body-md text-on-surface flex flex-col min-h-screen"
    paginaActiva="contacto"
>
<!-- CONTENEDOR PRINCIPAL EDITORIAL Y TARJETAS PREMIUM -->
<main class="w-full pt-20 flex-grow bg-background flex flex-col justify-center min-h-[85vh]">
    <div class="max-w-[80rem] mx-auto px-margin-mobile lg:px-margin-desktop w-full py-space-10">

        <!-- Encabezado Editorial -->
        <div class="flex flex-col items-center text-center max-w-2xl mx-auto mb-space-8">
            <div class="flex items-center justify-center gap-2 mb-2" aria-hidden="true">
                <span class="w-8 h-[1px] bg-primary/40"></span>
                <span class="font-headline-sm text-headline-sm italic text-secondary">✦</span>
                <span class="w-8 h-[1px] bg-primary/40"></span>
            </div>
            <p class="font-label-md text-label-md uppercase tracking-widest text-primary mb-1">
                Conversemos
            </p>
            <h1 class="font-headline-xl text-headline-lg lg:text-headline-xl text-on-surface dark:text-dark-on-background mb-2">
                Estamos aquí para ti
            </h1>
            <p class="font-body-md text-body-md text-on-surface-variant dark:text-dark-on-surface-variant mt-space-2 leading-relaxed">
                Ya sea para agendar una reunión, cotizar tu evento, o simplemente resolver dudas sobre nuestras
                suscripciones florales, nos encantará escucharte.
            </p>
        </div>

        <!-- Canales Directos: tarjetas compactas (el protagonismo es del formulario) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-3 max-w-4xl mx-auto">

            <!-- Tarjeta 1: WhatsApp -->
            <a href="https://wa.me/56997702832" target="_blank" rel="noopener noreferrer"
               class="group flex items-center gap-space-3 p-space-3 bg-surface dark:bg-dark-surface-container-low rounded-xl shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-0.5 border border-outline-variant/30 dark:border-dark-surface-variant focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
                <div class="w-12 h-12 shrink-0 rounded-full bg-primary/10 flex items-center justify-center text-primary group-hover:scale-110 transition-transform duration-300"
                     aria-hidden="true">
                    <svg class="w-6 h-6" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 258">
                        <path d="M128.534 0c34.098.017 66.102 13.29 90.167 37.383c24.066 24.092 37.312 56.12 37.299 90.174c-.028 69.579-56.076 126.318-125.36 127.446l-2.103.017h-.053c-21.005-.007-41.65-5.194-60.051-15.045l-.86-.466L0 257.233l18.083-66.055C6.93 171.852 1.061 149.922 1.07 127.455C1.098 57.178 58.279 0 128.534 0m.044 21.53c-58.437 0-105.964 47.523-105.987 105.936c-.008 19.712 5.424 38.921 15.719 55.612l.478.769l2.52 4.009l-10.703 39.093l40.097-10.517l3.869 2.294c16.007 9.499 34.32 14.599 53.017 14.764l.905.004h.044c58.392 0 105.918-47.526 105.942-105.943c.01-28.308-10.998-54.927-31.001-74.952s-46.603-31.06-74.9-31.07m-45.17 47.063c2.122 0 4.25.02 6.104.115c1.956.096 4.581-.743 7.165 5.466c.992 2.38 2.5 6.057 4.044 9.813l.331.805c2.485 6.045 4.969 12.072 5.447 13.029c.795 1.593 1.325 3.455.264 5.579c-1.06 2.127-1.593 3.454-3.184 5.316c-1.593 1.858-3.344 4.153-4.777 5.579l-.234.233l-.232.237c-1.42 1.469-2.608 3.153-.93 6.027c1.857 3.19 8.248 13.622 17.716 22.066c12.165 10.85 22.428 14.214 25.613 15.809s5.043 1.328 6.9-.8c1.859-2.124 7.961-9.298 10.085-12.487c2.123-3.188 4.246-2.655 7.166-1.593c1.387.505 5.654 2.511 10.092 4.649l1.38.666c4.443 2.15 8.776 4.288 10.29 5.046c3.185 1.595 5.309 2.392 6.104 3.719c.796 1.33.796 7.705-1.858 15.145s-15.378 14.23-21.497 15.146c-5.487.818-12.43 1.16-20.06-1.262c-4.624-1.47-10.558-3.429-18.157-6.71c-31.948-13.794-52.815-45.966-54.406-48.09l-.108-.144c-1.941-2.594-12.898-17.445-12.898-32.804c0-15.675 8.229-23.38 11.147-26.569c2.92-3.186 6.37-3.986 8.493-3.986"/>
                    </svg>
                </div>
                <div class="min-w-0 flex-1">
                    <h2 class="font-headline-md text-headline-sm text-on-surface dark:text-dark-on-background">
                        Escríbenos por WhatsApp</h2>
                    <p class="font-body-sm text-body-sm text-on-surface-variant dark:text-dark-on-surface-variant group-hover:text-primary transition-colors">
                        +56 9 9770 2832</p>
                </div>
                <svg class="w-5 h-5 shrink-0 text-on-surface-variant dark:text-dark-on-surface-variant group-hover:text-primary group-hover:translate-x-1 transition-all"
                     fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m12 4-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8-8-8z"/>
                </svg>
            </a>

            <!-- Tarjeta 2: Email -->
            <a href="mailto:lajardinera.floreria@gmail.com"
               class="group flex items-center gap-space-3 p-space-3 bg-surface dark:bg-dark-surface-container-low rounded-xl shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-0.5 border border-outline-variant/30 dark:border-dark-surface-variant focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
                <div class="w-12 h-12 shrink-0 rounded-full bg-primary/10 flex items-center justify-center text-primary group-hover:scale-110 transition-transform duration-300"
                     aria-hidden="true">
                    <!-- Ícono de Gmail en línea (copia de /public/icons/gmail.svg) para heredar el color de marca vía currentColor -->
                    <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <!-- Icon from Logos free icons by Streamline - https://creativecommons.org/licenses/by/4.0/ -->
                        <path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"
                              d="M3.688 4H2a1 1 0 0 0-1 1v.04l11 8.031l11-8.03V5a1 1 0 0 0-1-1h-1.688L12 9.92zm14.039 0L12 8.08L6.273 4zM23 6.898l-2.75 2.007V20H22a1 1 0 0 0 1-1zM18.75 20V10L12 14.928l-6.75-4.927V20zm-15 0V8.905L1 6.898V19a1 1 0 0 0 1 1z"/>
                    </svg>
                </div>
                <div class="min-w-0 flex-1">
                    <h2 class="font-headline-md text-headline-sm text-on-surface dark:text-dark-on-background">Envíanos
                        un Correo</h2>
                    <p class="font-body-sm text-body-sm text-on-surface-variant dark:text-dark-on-surface-variant group-hover:text-primary transition-colors break-all">
                        lajardinera.floreria@gmail.com</p>
                </div>
                <svg class="w-5 h-5 shrink-0 text-on-surface-variant dark:text-dark-on-surface-variant group-hover:text-primary group-hover:translate-x-1 transition-all"
                     fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m12 4-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8-8-8z"/>
                </svg>
            </a>
        </div>

        <!-- Separador editorial -->
        <div class="flex items-center gap-space-3 max-w-4xl mx-auto my-space-6" aria-hidden="true">
            <span class="flex-1 h-px bg-outline-variant/40"></span>
            <span class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant dark:text-dark-on-surface-variant">o completa el formulario</span>
            <span class="flex-1 h-px bg-outline-variant/40"></span>
        </div>

        <!-- FORMULARIO DE CONTACTO: contact-form.js arma el mensaje y lo abre en WhatsApp -->
        <section
                class="max-w-4xl mx-auto bg-surface dark:bg-dark-surface-container-low rounded-2xl shadow-lg border border-outline-variant/30 dark:border-dark-surface-variant p-space-4 sm:p-space-6 lg:p-space-8"
                aria-labelledby="form-title">
            <div class="mb-space-6">
                <h2 id="form-title"
                    class="font-headline-lg text-headline-md lg:text-headline-lg text-on-surface dark:text-dark-on-background">
                    Envíanos tu consulta</h2>
                <p class="font-body-md text-body-md text-on-surface-variant dark:text-dark-on-surface-variant mt-1">
                    Cuéntanos qué necesitas y te responderemos a la brevedad.</p>
            </div>

            <!-- Aviso de servicio precargado: lo muestra contact-form.js cuando la URL trae ?service= -->
            <p id="service-notice"
               class="hidden mb-space-4 flex items-center gap-space-2 rounded-lg bg-primary/10 px-space-3 py-space-2 font-body-sm text-body-sm text-on-surface dark:text-dark-on-background"
               role="status">
                <svg class="w-5 h-5 shrink-0 text-primary" fill="currentColor" xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                </svg>
                <span>Estás cotizando: <strong id="service-notice-name" class="font-semibold"></strong></span>
            </p>

            <form id="contact-form" action="#" method="post"
                  class="grid grid-cols-1 md:grid-cols-2 gap-x-space-4 gap-y-space-3">

                <!-- Nombre -->
                <div class="flex flex-col gap-1.5">
                    <label for="contact-name"
                           class="font-label-md text-label-md uppercase tracking-wider text-on-surface dark:text-dark-on-background">Nombre
                        <span class="text-primary" aria-hidden="true">*</span></label>
                    <input id="contact-name" name="nombre" type="text" required autocomplete="name" maxlength="80"
                           placeholder="Tu nombre"
                           class="w-full rounded-lg bg-background dark:bg-dark-background border border-outline dark:border-dark-neutral-100 px-space-2 py-3 font-body-md text-body-md text-on-surface dark:text-dark-on-background placeholder:text-on-surface-variant/70 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/30 transition-colors"/>
                </div>

                <!-- Email -->
                <div class="flex flex-col gap-1.5">
                    <label for="contact-email"
                           class="font-label-md text-label-md uppercase tracking-wider text-on-surface dark:text-dark-on-background">Email
                        <span class="text-primary" aria-hidden="true">*</span></label>
                    <input id="contact-email" name="email" type="email" required autocomplete="email" maxlength="120"
                           placeholder="tu@correo.com"
                           class="w-full rounded-lg bg-background dark:bg-dark-background border border-outline dark:border-dark-neutral-100 px-space-2 py-3 font-body-md text-body-md text-on-surface dark:text-dark-on-background placeholder:text-on-surface-variant/70 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/30 transition-colors"/>
                </div>

                <!-- Teléfono -->
                <div class="flex flex-col gap-1.5">
                    <label for="contact-phone"
                           class="font-label-md text-label-md uppercase tracking-wider text-on-surface dark:text-dark-on-background">Teléfono
                        <span class="normal-case tracking-normal font-normal text-on-surface-variant dark:text-dark-on-surface-variant">(opcional)</span></label>
                    <input id="contact-phone" name="telefono" type="tel" autocomplete="tel" maxlength="20"
                           placeholder="+56 9 1234 5678"
                           class="w-full rounded-lg bg-background dark:bg-dark-background border border-outline dark:border-dark-neutral-100 px-space-2 py-3 font-body-md text-body-md text-on-surface dark:text-dark-on-background placeholder:text-on-surface-variant/70 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/30 transition-colors"/>
                </div>

                <!-- Servicio de interés (se precarga desde ?service=) -->
                <div class="flex flex-col gap-1.5">
                    <label for="contact-service"
                           class="font-label-md text-label-md uppercase tracking-wider text-on-surface dark:text-dark-on-background">Servicio
                        de interés</label>
                    <select id="contact-service" name="servicio"
                            class="w-full rounded-lg bg-background dark:bg-dark-background border border-outline dark:border-dark-neutral-100 px-space-2 py-3 font-body-md text-body-md text-on-surface dark:text-dark-on-background focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/30 transition-colors cursor-pointer">
                        <option value="">Selecciona una opción</option>
                        <optgroup label="Servicios">
                            <option value="Suscripción floral">Suscripción floral</option>
                            <option value="Gift Cards">Gift Cards</option>
                            <option value="Novias y Novios">Novias y Novios</option>
                            <option value="Ramos de Autor">Ramos de Autor</option>
                            <option value="Flores para un Matrimonio">Flores para un Matrimonio</option>
                            <option value="Novios por el Río">Novios por el Río</option>
                            <option value="Eventos y Celebraciones">Eventos y Celebraciones</option>
                            <option value="Condolencias">Condolencias</option>
                        </optgroup>
                        <optgroup label="Planes de suscripción">
                            <option value="Plan Esencial">Plan Esencial</option>
                            <option value="Plan Premiere">Plan Premiere</option>
                            <option value="Plan Luxe">Plan Luxe</option>
                        </optgroup>
                        <option value="Otro">Otro / Consulta general</option>
                    </select>
                </div>

                <!-- Fecha del evento -->
                <div class="flex flex-col gap-1.5 md:col-span-2">
                    <label for="contact-date"
                           class="font-label-md text-label-md uppercase tracking-wider text-on-surface dark:text-dark-on-background">Fecha
                        del evento o entrega <span
                                class="normal-case tracking-normal font-normal text-on-surface-variant dark:text-dark-on-surface-variant">(opcional)</span></label>
                    <input id="contact-date" name="fecha" type="date"
                           class="w-full md:w-1/2 md:pr-space-2 rounded-lg bg-background dark:bg-dark-background border border-outline dark:border-dark-neutral-100 px-space-2 py-3 font-body-md text-body-md text-on-surface dark:text-dark-on-background dark:[color-scheme:dark] focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/30 transition-colors"/>
                </div>

                <!-- Mensaje -->
                <div class="flex flex-col gap-1.5 md:col-span-2">
                    <label for="contact-message"
                           class="font-label-md text-label-md uppercase tracking-wider text-on-surface dark:text-dark-on-background">Mensaje
                        <span class="text-primary" aria-hidden="true">*</span></label>
                    <textarea id="contact-message" name="mensaje" rows="5" required maxlength="1500"
                              placeholder="Cuéntanos sobre tu idea, ocasión, colores favoritos o cualquier detalle que nos ayude a cotizar."
                              class="w-full resize-y rounded-lg bg-background dark:bg-dark-background border border-outline dark:border-dark-neutral-100 px-space-2 py-3 font-body-md text-body-md text-on-surface dark:text-dark-on-background placeholder:text-on-surface-variant/70 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/30 transition-colors"></textarea>
                </div>

                <!-- Pie del formulario -->
                <div class="md:col-span-2 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-space-3 pt-space-2">
                    <div class="flex flex-col gap-1">
                        <p class="font-body-xs text-body-xs text-on-surface-variant dark:text-dark-on-surface-variant">
                            <span class="text-primary" aria-hidden="true">*</span> Campos obligatorios</p>
                        <p class="font-body-xs text-body-xs text-on-surface-variant dark:text-dark-on-surface-variant">
                            Al enviar, se abrirá WhatsApp con tu mensaje listo para enviar.</p>
                    </div>
                    <button type="submit"
                            class="group inline-flex items-center justify-center gap-space-1 w-full sm:w-auto font-label-lg text-label-lg uppercase tracking-wider font-semibold text-white dark:text-neutral-950 bg-primary hover:bg-primary/90 transition-colors px-space-6 py-3.5 rounded-lg shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-primary">
                        <svg class="w-5 h-5" fill="currentColor" xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 256 258" aria-hidden="true">
                            <path d="M128.534 0c34.098.017 66.102 13.29 90.167 37.383c24.066 24.092 37.312 56.12 37.299 90.174c-.028 69.579-56.076 126.318-125.36 127.446l-2.103.017h-.053c-21.005-.007-41.65-5.194-60.051-15.045l-.86-.466L0 257.233l18.083-66.055C6.93 171.852 1.061 149.922 1.07 127.455C1.098 57.178 58.279 0 128.534 0m.044 21.53c-58.437 0-105.964 47.523-105.987 105.936c-.008 19.712 5.424 38.921 15.719 55.612l.478.769l2.52 4.009l-10.703 39.093l40.097-10.517l3.869 2.294c16.007 9.499 34.32 14.599 53.017 14.764l.905.004h.044c58.392 0 105.918-47.526 105.942-105.943c.01-28.308-10.998-54.927-31.001-74.952s-46.603-31.06-74.9-31.07m-45.17 47.063c2.122 0 4.25.02 6.104.115c1.956.096 4.581-.743 7.165 5.466c.992 2.38 2.5 6.057 4.044 9.813l.331.805c2.485 6.045 4.969 12.072 5.447 13.029c.795 1.593 1.325 3.455.264 5.579c-1.06 2.127-1.593 3.454-3.184 5.316c-1.593 1.858-3.344 4.153-4.777 5.579l-.234.233l-.232.237c-1.42 1.469-2.608 3.153-.93 6.027c1.857 3.19 8.248 13.622 17.716 22.066c12.165 10.85 22.428 14.214 25.613 15.809s5.043 1.328 6.9-.8c1.859-2.124 7.961-9.298 10.085-12.487c2.123-3.188 4.246-2.655 7.166-1.593c1.387.505 5.654 2.511 10.092 4.649l1.38.666c4.443 2.15 8.776 4.288 10.29 5.046c3.185 1.595 5.309 2.392 6.104 3.719c.796 1.33.796 7.705-1.858 15.145s-15.378 14.23-21.497 15.146c-5.487.818-12.43 1.16-20.06-1.262c-4.624-1.47-10.558-3.429-18.157-6.71c-31.948-13.794-52.815-45.966-54.406-48.09l-.108-.144c-1.941-2.594-12.898-17.445-12.898-32.804c0-15.675 8.229-23.38 11.147-26.569c2.92-3.186 6.37-3.986 8.493-3.986"/>
                        </svg>
                        Enviar por WhatsApp
                    </button>
                </div>
                <!-- Estado accesible del envío (lo escribe contact-form.js) -->
                <p id="form-status" class="md:col-span-2 font-body-sm text-body-sm text-primary" role="status"
                   aria-live="polite"></p>
            </form>
        </section>
    </div>
</main>
</BaseLayout>

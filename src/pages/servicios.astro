---
import BaseLayout from '../layouts/BaseLayout.astro';
import FranjaBeneficios from '../components/secciones/FranjaBeneficios.astro';
---

<BaseLayout
    title="Servicios - La Jardinera Florería"
    bodyClass="bg-background font-body-md text-body-md text-on-surface"
    paginaActiva="servicios"
>
<main class="w-full pt-20 bg-background min-h-screen flex flex-col items-center">
    <!-- 1. SECCIÓN PRINCIPAL: CATÁLOGO DE SERVICIOS -->
    <section class="w-full max-w-[80rem] mx-auto px-margin-mobile lg:px-margin-desktop py-space-8 flex-grow">
        <!-- Encabezado de la Sección con Rombo ✦ -->
        <div class="flex flex-col items-center text-center max-w-2xl mx-auto mb-space-8">
            <div class="flex items-center justify-center gap-2 mb-2">
                <span class="w-8 h-[1px] bg-primary/40"></span>
                <span class="font-headline-sm text-headline-sm italic text-secondary">✦</span>
                <span class="w-8 h-[1px] bg-primary/40"></span>
            </div>
            <h1 class="font-headline-xl text-headline-lg lg:text-headline-xl text-on-surface mb-2">Catálogo de
                servicios</h1>
            <p class="font-body-md text-body-md text-on-surface-variant max-w-xl mx-auto">Creamos experiencias florales
                únicas para cada ocasión, fusionando arte y naturaleza con un enfoque editorial y personalizado.</p>
        </div>

        <!-- Grilla de 8 Tarjetas -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-space-4">
            <!-- Tarjeta 1: Suscripción floral -->
            <article
                    class="group flex flex-col bg-surface rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-1 border border-outline-variant/30">
                <!-- Contenedor Anti-CLS de Imagen -->
                <div class="relative w-full aspect-[4/5] overflow-hidden bg-surface-container">
                    <img src="/images/servicios/suscripcion.webp"
                         alt="Suscripción floral - Flores frescas a domicilio en Valdivia"
                         width="400"
                         height="500"
                         loading="lazy"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"/>
                </div>
                <!-- Contenido de la Tarjeta -->
                <div class="flex flex-col flex-grow p-space-4">
                    <div class="flex items-center gap-2 text-primary mb-1">
                        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                            <!-- Icon from Material Design Icons by Pictogrammers - https://github.com/Templarian/MaterialDesign/blob/master/LICENSE -->
                            <path fill="currentColor" d="M3 13a9 9 0 0 0 9 9c0-5-4.03-9-9-9m9-7.5A2.5 2.5 0 0 1 14.5 8a2.5 2.5 0 0 1-2.5 2.5A2.5 2.5 0 0 1 9.5 8A2.5 2.5 0 0 1 12 5.5m-6.4 4.75a2.5 2.5 0 0 0 2.5 2.5c.53 0 1.02-.17 1.4-.44v.19A2.5 2.5 0 0 0 12 15a2.5 2.5 0 0 0 2.5-2.5v-.19c.38.27.87.44 1.4.44a2.5 2.5 0 0 0 2.5-2.5c0-1-.59-1.85-1.43-2.25c.84-.4 1.43-1.26 1.43-2.25a2.5 2.5 0 0 0-2.5-2.5c-.53 0-1.02.16-1.4.44V3.5A2.5 2.5 0 0 0 12 1a2.5 2.5 0 0 0-2.5 2.5v.19c-.38-.28-.87-.44-1.4-.44a2.5 2.5 0 0 0-2.5 2.5c0 .99.59 1.85 1.43 2.25c-.84.4-1.43 1.25-1.43 2.25M12 22a9 9 0 0 0 9-9c-5 0-9 4-9 9"/>
                        </svg>
                        <span class="font-label-sm text-label-sm uppercase tracking-wider">Suscripción</span>
                    </div>
                    <h3 class="font-headline-md text-headline-md text-on-surface mb-2">Suscripción floral</h3>
                    <p class="font-body-sm text-body-sm text-on-surface-variant mb-space-4 flex-grow leading-relaxed">
                        Quien empieza a vivir con flores, difícilmente quiere volver a vivir sin ellas.</p>
                    <button class="open-modal-btn mt-auto inline-flex items-center gap-1.5 self-start rounded-lg px-3 py-2 bg-primary/10 hover:bg-primary/20 font-label-md text-label-md text-primary uppercase tracking-wider font-semibold transition-colors cursor-pointer group/btn focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                            type="button"
                            data-service-id="suscripcion">
                        <span>Ver más</span>
                        <svg class="w-4 h-4 transform group-hover/btn:translate-x-1 transition-transform"
                             fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/>
                        </svg>
                    </button>
                </div>
            </article>

            <!-- Tarjeta 2: Gift Cards -->
            <article
                    class="group flex flex-col bg-primary/10 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-1 border border-outline-variant/30">
                <!-- Contenedor Anti-CLS de Imagen -->
                <div class="relative w-full aspect-[4/5] overflow-hidden bg-surface-container">
                    <img src="/images/servicios/gift-cards.webp"
                         alt="Gift Cards de experiencias florales - La Jardinera"
                         width="400"
                         height="500"
                         loading="lazy"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"/>
                </div>
                <!-- Contenido de la Tarjeta -->
                <div class="flex flex-col flex-grow p-space-4">
                    <div class="flex items-center gap-2 text-primary mb-1">
                        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                            <!-- Icon from Material Design Icons by Pictogrammers - https://github.com/Templarian/MaterialDesign/blob/master/LICENSE -->
                            <path fill="currentColor" d="M20 14H4V8h5.08L7 10.83L8.62 12L11 8.76l1-1.36l1 1.36L15.38 12L17 10.83L14.92 8H20m0 11H4v-2h16M9 4a1 1 0 0 1 1 1a1 1 0 0 1-1 1a1 1 0 0 1-1-1a1 1 0 0 1 1-1m6 0a1 1 0 0 1 1 1a1 1 0 0 1-1 1a1 1 0 0 1-1-1a1 1 0 0 1 1-1m5 2h-2.18c.11-.31.18-.65.18-1a3 3 0 0 0-3-3c-1.05 0-1.96.54-2.5 1.35L12 4l-.5-.66C10.96 2.54 10.05 2 9 2a3 3 0 0 0-3 3c0 .35.07.69.18 1H4c-1.11 0-2 .89-2 2v11c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2"/>
                        </svg>
                        <span class="font-label-sm text-label-sm uppercase tracking-wider">Regalos</span>
                    </div>
                    <h3 class="font-headline-md text-headline-md text-on-surface mb-2">Gift Cards</h3>
                    <p class="font-body-sm text-body-sm text-on-surface-variant mb-space-4 flex-grow leading-relaxed">
                        Hay regalos que se disfrutan en un instante. Otros que se disfrutan mucho después de
                        recibirlos.</p>
                    <button class="open-modal-btn mt-auto inline-flex items-center gap-1.5 self-start rounded-lg px-3 py-2 bg-surface hover:bg-surface-container-high font-label-md text-label-md text-primary uppercase tracking-wider font-semibold transition-colors cursor-pointer group/btn focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                            type="button"
                            data-service-id="gift-cards">
                        <span>Ver más</span>
                        <svg class="w-4 h-4 transform group-hover/btn:translate-x-1 transition-transform"
                             fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/>
                        </svg>
                    </button>
                </div>
            </article>

            <!-- Tarjeta 3: Novias y Novios -->
            <article
                    class="group flex flex-col bg-secondary/10 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-1 border border-outline-variant/30">
                <!-- Contenedor Anti-CLS de Imagen -->
                <div class="relative w-full aspect-[4/5] overflow-hidden bg-surface-container">
                    <img src="/images/servicios/novias.webp"
                         alt="Ramos de novia y boutonnière para matrimonios"
                         width="400"
                         height="500"
                         loading="lazy"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"/>
                </div>
                <!-- Contenido de la Tarjeta -->
                <div class="flex flex-col flex-grow p-space-4">
                    <div class="flex items-center gap-2 text-primary mb-1">
                        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                            <!-- Icon from Lucide Lab by Lucide Contributors - https://github.com/lucide-icons/lucide-lab/blob/main/LICENSE -->
                            <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                                <path d="M18 9.52a4.04 4.04 0 1 1 2-3.47"/>
                                <circle cx="17" cy="7.8" r="2"/>
                                <path d="m14 2.5l-2 1.3a6 6 0 1 0 6 10.4l2-1.2a4 4 0 0 0-4-6.95"/>
                                <path d="M9.77 12C4 15 2 22 2 22"/>
                                <path d="M13 20s-5 3-9.2-2c0 0 5.2-3 9.2 2"/>
                            </g>
                        </svg>
                        <span class="font-label-sm text-label-sm uppercase tracking-wider">Novias</span>
                    </div>
                    <h3 class="font-headline-md text-headline-md text-on-surface mb-2">Novias y Novios</h3>
                    <p class="font-body-sm text-body-sm text-on-surface-variant mb-space-4 flex-grow leading-relaxed">No
                        diseñamos un ramo o un boutonnière para un matrimonio; sino piezas florales para personas
                        especiales.</p>
                    <button class="open-modal-btn mt-auto inline-flex items-center gap-1.5 self-start rounded-lg px-3 py-2 bg-surface hover:bg-surface-container-high font-label-md text-label-md text-primary uppercase tracking-wider font-semibold transition-colors cursor-pointer group/btn focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                            type="button"
                            data-service-id="novias">
                        <span>Ver más</span>
                        <svg class="w-4 h-4 transform group-hover/btn:translate-x-1 transition-transform"
                             fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/>
                        </svg>
                    </button>
                </div>
            </article>

            <!-- Tarjeta 4: Ramos de Autor -->
            <article
                    class="group flex flex-col bg-surface rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-1 border border-outline-variant/30">
                <!-- Contenedor Anti-CLS de Imagen -->
                <div class="relative w-full aspect-[4/5] overflow-hidden bg-surface-container">
                    <img src="/images/servicios/ramos-de-autor.webp"
                         alt="Ramos de flores de autor con diseño floral único"
                         width="400"
                         height="500"
                         loading="lazy"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"/>
                </div>
                <!-- Contenido de la Tarjeta -->
                <div class="flex flex-col flex-grow p-space-4">
                    <div class="flex items-center gap-2 text-primary mb-1">
                        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                            <!-- Icon from Lucide Lab by Lucide Contributors - https://github.com/lucide-icons/lucide-lab/blob/main/LICENSE -->
                            <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                                <path d="M12 20c0-5.5-4.5-10-10-10c0 5.5 4.5 10 10 10"/>
                                <path d="M9.7 8.3c-1.8-2-3.8-3.1-3.8-3.1s-.8 2.5-.5 5.4"/>
                                <path d="M15 12.9V12c0-4.4-3-8-3-8s-3 3.6-3 8v.9"/>
                                <path d="M18.6 10.6c.3-2.9-.5-5.4-.5-5.4s-2 1-3.8 3.1"/>
                                <path d="M12 20c5.5 0 10-4.5 10-10c-5.5 0-10 4.5-10 10"/>
                            </g>
                        </svg>
                        <span class="font-label-sm text-label-sm uppercase tracking-wider">Ramos</span>
                    </div>
                    <h3 class="font-headline-md text-headline-md text-on-surface mb-2">Ramos de Autor</h3>
                    <p class="font-body-sm text-body-sm text-on-surface-variant mb-space-4 flex-grow leading-relaxed">Un
                        Ramo de autor será perfecto para celebrar, agradecer o simplemente alegrar el día de
                        alguien.</p>
                    <button class="open-modal-btn mt-auto inline-flex items-center gap-1.5 self-start rounded-lg px-3 py-2 bg-primary/10 hover:bg-primary/20 font-label-md text-label-md text-primary uppercase tracking-wider font-semibold transition-colors cursor-pointer group/btn focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                            type="button"
                            data-service-id="ramos-de-autor">
                        <span>Ver más</span>
                        <svg class="w-4 h-4 transform group-hover/btn:translate-x-1 transition-transform"
                             fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/>
                        </svg>
                    </button>
                </div>
            </article>

            <!-- Tarjeta 5: Flores para un Matrimonio -->
            <article
                    class="group flex flex-col bg-primary/10 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-1 border border-outline-variant/30">
                <!-- Contenedor Anti-CLS de Imagen -->
                <div class="relative w-full aspect-[4/5] overflow-hidden bg-surface-container">
                    <img src="/images/servicios/matrimonios.webp"
                         alt="Decoración floral y ambientación para matrimonios"
                         width="400"
                         height="500"
                         loading="lazy"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"/>
                </div>
                <!-- Contenido de la Tarjeta -->
                <div class="flex flex-col flex-grow p-space-4">
                    <div class="flex items-center gap-2 text-primary mb-1">
                        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                            <!-- Icon from Lucide Lab by Lucide Contributors - https://github.com/lucide-icons/lucide-lab/blob/main/LICENSE -->
                            <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                                <path d="M14 6a4 4 0 1 1-2-3.46"/>
                                <circle cx="12" cy="6" r="2"/>
                                <path d="M10 6a4 4 0 0 1 8 0v2A6 6 0 0 1 6 8V6m6 8v8m0 0c-4.2 0-7-1.667-7-5c4.2 0 7 1.667 7 5m0 0c4.2 0 7-1.667 7-5c-4.2 0-7 1.667-7 5"/>
                            </g>
                        </svg>
                        <span class="font-label-sm text-label-sm uppercase tracking-wider">Matrimonios</span>
                    </div>
                    <h3 class="font-headline-md text-headline-md text-on-surface mb-2">Flores para un Matrimonio</h3>
                    <p class="font-body-sm text-body-sm text-on-surface-variant mb-space-4 flex-grow leading-relaxed">La
                        decoración floral de un matrimonio no debe seguir tendencias, sino reflejar la esencia de
                        quienes están a punto de comenzar una nueva vida juntos.</p>
                    <button class="open-modal-btn mt-auto inline-flex items-center gap-1.5 self-start rounded-lg px-3 py-2 bg-surface hover:bg-surface-container-high font-label-md text-label-md text-primary uppercase tracking-wider font-semibold transition-colors cursor-pointer group/btn focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                            type="button"
                            data-service-id="matrimonios">
                        <span>Ver más</span>
                        <svg class="w-4 h-4 transform group-hover/btn:translate-x-1 transition-transform"
                             fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/>
                        </svg>
                    </button>
                </div>
            </article>

            <!-- Tarjeta 6: Novios por el Río -->
            <article
                    class="group flex flex-col bg-secondary/10 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-1 border border-outline-variant/30">
                <!-- Contenedor Anti-CLS de Imagen -->
                <div class="relative w-full aspect-[4/5] overflow-hidden bg-surface-container">
                    <img src="/images/servicios/novios-rio.webp"
                         alt="Navegación floral para novios en lancha MaGu por el Río Calle-Calle"
                         width="400"
                         height="500"
                         loading="lazy"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"/>
                </div>
                <!-- Contenido de la Tarjeta -->
                <div class="flex flex-col flex-grow p-space-4">
                    <div class="flex items-center gap-2 text-primary mb-1">
                        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                            <!-- Icon from Material Design Icons by Pictogrammers - https://github.com/Templarian/MaterialDesign/blob/master/LICENSE -->
                            <path fill="currentColor" d="m3 13.5l8-11.47V13.5zm9.5 0c1.35-3.75 1.17-8.79 0-12.5c4.76 1.54 8.4 7.4 8.46 12.5zm8.6 3.58c-.41.64-.89 1.19-1.45 1.66c-.65-.29-1.23-.74-1.69-1.24c-1.49 1.93-4.5 1.93-5.99 0c-1.47 1.93-4.5 1.93-5.97 0c-.5.5-1.05.95-1.7 1.24c-1.14-.94-2-2.28-2.3-3.74h19.94a6.4 6.4 0 0 1-.84 2.08M20.96 23q-1.59 0-3-.75c-1.84 1-4.15 1-5.99 0c-1.84 1-4.15 1-5.97 0c-1.23.69-2.64.8-4 .75v-2c1.41.05 2.77-.1 4-1c1.74 1.25 4.21 1.25 5.97 0c1.77 1.25 4.23 1.25 5.99 0c1.21.9 2.58 1.05 3.98 1v2z"/>
                        </svg>
                        <span class="font-label-sm text-label-sm uppercase tracking-wider">Lancha</span>
                    </div>
                    <h3 class="font-headline-md text-headline-md text-on-surface mb-2">Novios por el Río</h3>
                    <p class="font-body-sm text-body-sm text-on-surface-variant mb-space-4 flex-grow leading-relaxed">
                        Novios por el Río en nuestra lancha MaGu es un momento fabuloso.</p>
                    <button class="open-modal-btn mt-auto inline-flex items-center gap-1.5 self-start rounded-lg px-3 py-2 bg-surface hover:bg-surface-container-high font-label-md text-label-md text-primary uppercase tracking-wider font-semibold transition-colors cursor-pointer group/btn focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                            type="button"
                            data-service-id="novios-rio">
                        <span>Ver más</span>
                        <svg class="w-4 h-4 transform group-hover/btn:translate-x-1 transition-transform"
                             fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/>
                        </svg>
                    </button>
                </div>
            </article>

            <!-- Tarjeta 7: Eventos y Celebraciones -->
            <article
                    class="group flex flex-col bg-surface rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-1 border border-outline-variant/30">
                <!-- Contenedor Anti-CLS de Imagen -->
                <div class="relative w-full aspect-[4/5] overflow-hidden bg-surface-container">
                    <img src="/images/servicios/eventos.webp"
                         alt="Arreglos florales de autor para eventos y celebraciones"
                         width="400"
                         height="500"
                         loading="lazy"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"/>
                </div>
                <!-- Contenido de la Tarjeta -->
                <div class="flex flex-col flex-grow p-space-4">
                    <div class="flex items-center gap-2 text-primary mb-1">
                        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                            <!-- Icon from Material Design Icons by Pictogrammers - https://github.com/Templarian/MaterialDesign/blob/master/LICENSE -->
                            <path fill="currentColor" d="M19 19V8H5v11zM16 1h2v2h1a2 2 0 0 1 2 2v14c0 1.11-.89 2-2 2H5a2 2 0 0 1-2-2V5c0-1.1.9-2 2-2h1V1h2v2h8zm-4 16.17l-.58-.53C9.36 14.77 8 13.54 8 12.03c0-1.23.97-2.2 2.2-2.2c.7 0 1.36.32 1.8.83c.44-.51 1.1-.83 1.8-.83c1.23 0 2.2.97 2.2 2.2c0 1.51-1.36 2.74-3.42 4.61z"/>
                        </svg>
                        <span class="font-label-sm text-label-sm uppercase tracking-wider">Eventos</span>
                    </div>
                    <h3 class="font-headline-md text-headline-md text-on-surface mb-2">Eventos y Celebraciones</h3>
                    <p class="font-body-sm text-body-sm text-on-surface-variant mb-space-4 flex-grow leading-relaxed">
                        Las flores tienen la capacidad de hacer los momentos inolvidables.</p>
                    <button class="open-modal-btn mt-auto inline-flex items-center gap-1.5 self-start rounded-lg px-3 py-2 bg-primary/10 hover:bg-primary/20 font-label-md text-label-md text-primary uppercase tracking-wider font-semibold transition-colors cursor-pointer group/btn focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                            type="button"
                            data-service-id="eventos">
                        <span>Ver más</span>
                        <svg class="w-4 h-4 transform group-hover/btn:translate-x-1 transition-transform"
                             fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/>
                        </svg>
                    </button>
                </div>
            </article>

            <!-- Tarjeta 8: Condolencias -->
            <article
                    class="group flex flex-col bg-primary/10 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-1 border border-outline-variant/30">
                <!-- Contenedor Anti-CLS de Imagen -->
                <div class="relative w-full aspect-[4/5] overflow-hidden bg-surface-container">
                    <img src="/images/servicios/condolencias.webp"
                         alt="Coronas y homenajes florales para condolencias"
                         width="400"
                         height="500"
                         loading="lazy"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"/>
                </div>
                <!-- Contenido de la Tarjeta -->
                <div class="flex flex-col flex-grow p-space-4">
                    <div class="flex items-center gap-2 text-primary mb-1">
                        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                            <!-- Icon from Material Design Icons by Pictogrammers - https://github.com/Templarian/MaterialDesign/blob/master/LICENSE -->

            <div class="flex-none border-t border-outline-variant/30 bg-surface px-space-4 py-space-3">
                <a id="modal-cotizar-btn" href="/contacto"
                   class="w-full inline-flex items-center justify-center gap-2 font-label-lg text-label-lg text-neutral-50 dark:text-on-primary bg-primary hover:bg-primary/90 transition-all px-space-4 py-3.5 rounded-lg shadow-md uppercase tracking-wider">

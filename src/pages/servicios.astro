                <span class="inline-block px-2.5 py-0.5 rounded-[999px] bg-surface-container-lowest/20 backdrop-blur-md text-neutral-50 font-label-sm text-label-sm uppercase tracking-widest mb-space-1">Servicio</span>
                <h3 id="modal-title"
                    class="font-headline-lg text-headline-md md:text-headline-lg text-neutral-50 leading-tight"></h3>
            </figcaption>
        </figure>

        <!-- Columna derecha: contenido desplazable + CTA fijo -->
        <div class="flex flex-col flex-1 min-w-0 bg-surface">

            <div class="modal-scroll flex-1 overflow-y-auto px-space-4 py-space-4 md:px-space-5 md:py-space-5">
                <div id="modal-description" class="modal-prose font-body-md"></div>

                <section id="modal-gallery-section" class="mt-space-5">
                    <h4 class="font-headline-md text-headline-sm text-on-surface pb-space-1 mb-space-3 border-b border-outline-variant/30">
                        Galería del Servicio

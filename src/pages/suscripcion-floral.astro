---
import BaseLayout from '../layouts/BaseLayout.astro';
import FranjaBeneficios from '../components/secciones/FranjaBeneficios.astro';
---

<BaseLayout
    title="Suscripción Floral - La Jardinera Florería"
    bodyClass="bg-background font-body-md text-body-md text-on-surface"
    paginaActiva="suscripcion-floral"
>
<main class="w-full pt-20 bg-background min-h-screen flex flex-col flex-grow">
    <!-- 1. HERO BANNER DINÁMICO -->
    <section class="h-[80vh] md:h-[600px] relative overflow-hidden flex items-center justify-center">
        <!-- Capas de Imagen para Cross-fade Carousel -->
        <div id="banner-carousel" class="absolute inset-0 z-0 bg-dark-background">
            <img src="/images/suscripcion/hero-1.webp" alt="Ramo de suscripción floral 1" width="720"
                 height="1280" fetchpriority="high"
                 class="absolute inset-0 w-full h-full object-cover opacity-100 transition-opacity duration-1000"/>
            <img src="/images/suscripcion/hero-2.webp" alt="Ramo de suscripción floral 2" width="720"
                 height="1280" loading="lazy"
                 class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-1000"/>
            <img src="/images/suscripcion/hero-3.webp" alt="Ramo de suscripción floral 3" width="720"
                 height="1280" loading="lazy"
                 class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-1000"/>
            <img src="/images/suscripcion/hero-4.webp" alt="Ramo de suscripción floral 4" width="1440"
                 height="1621" loading="lazy"
                 class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-1000"/>
        </div>

        <!-- Overlay de Oscurecimiento Sutil para Contraste -->
        <div class="absolute inset-0 z-[1] bg-black/30 pointer-events-none" aria-hidden="true"></div>

        <!-- Caja de Texto Central (Glassmorphism) -->
        <div class="relative z-10 bg-surface/85 dark:bg-dark-surface-container-low/85 backdrop-blur-md rounded-xl p-space-6 lg:p-space-8 shadow-xl max-w-3xl text-center mx-4 border border-outline-variant/30 dark:border-dark-surface-variant flex flex-col items-center gap-4">
            <div class="flex items-center justify-center gap-2">
                <span class="w-8 h-[1px] bg-primary/40"></span>
                <span class="font-headline-sm text-headline-sm italic text-secondary">✦</span>
                <span class="w-8 h-[1px] bg-primary/40"></span>
            </div>
            <h1 class="font-headline-xl text-headline-lg lg:text-headline-xl text-on-surface dark:text-dark-on-background">
                Suscripciones Florales</h1>
            <p class="font-body-md text-body-md text-on-surface-variant dark:text-dark-on-surface-variant max-w-2xl leading-relaxed">
                Hay personas que reciben flores de vez en cuando. Y hay quienes eligen vivir con ellas. Nuestras
                suscripciones florales son para quienes han descubierto que la belleza no debería reservarse para las
                grandes ocasiones. Que una mesa, una cocina, un estudio o un espacio de trabajo cambian por completo
                cuando las flores pasan a formar parte de la vida cotidiana.
            </p>
        </div>
    </section>

    <!-- 2. SECCIÓN ASIMÉTRICA: CONDICIONES DEL SERVICIO Y ZONAS DE ENVÍO -->
    <section class="w-full max-w-[80rem] mx-auto py-space-8 px-margin-mobile lg:px-margin-desktop scroll-mt-24"
             id="info-suscripcion">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-space-8 items-start">
            <!-- Columna Izquierda: Condiciones del Servicio -->
            <div class="flex flex-col h-full">
                <div class="mb-space-6 group cursor-default">
                    <h2 class="font-headline-lg text-headline-md lg:text-headline-lg text-on-surface dark:text-dark-on-background mb-2">
                        Condiciones del Servicio</h2>
                    <div class="w-24 h-[1.5px] bg-primary/40 transition-all duration-500 group-hover:w-32"></div>
                </div>
                <div class="space-y-space-6">
                    <!-- Condición 1: Flores de temporada -->
                    <div class="flex items-start gap-space-4">
                        <div class="flex-shrink-0 w-14 h-14 rounded-full bg-surface-container-low dark:bg-dark-surface-container-low flex items-center justify-center text-primary border border-outline-variant/30 dark:border-dark-surface-variant shadow-sm">
                            <svg class="w-7 h-7 text-primary" fill="currentColor" xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24">
                                <path d="M3,13A9,9 0 0,0 12,22C12,17 7.97,13 3,13M12,5.5A2.5,2.5 0 0,1 14.5,8A2.5,2.5 0 0,1 12,10.5A2.5,2.5 0 0,1 9.5,8A2.5,2.5 0 0,1 12,5.5M5.6,10.25A2.5,2.5 0 0,0 8.1,12.75C8.63,12.75 9.12,12.58 9.5,12.31C9.5,12.37 9.5,12.43 9.5,12.5A2.5,2.5 0 0,0 12,15A2.5,2.5 0 0,0 14.5,12.5C14.5,12.43 14.5,12.37 14.5,12.31C14.88,12.58 15.37,12.75 15.9,12.75C17.28,12.75 18.4,11.63 18.4,10.25C18.4,9.25 17.81,8.4 16.97,8C17.81,7.6 18.4,6.74 18.4,5.75C18.4,4.37 17.28,3.25 15.9,3.25C15.37,3.25 14.88,3.41 14.5,3.69C14.5,3.63 14.5,3.56 14.5,3.5A2.5,2.5 0 0,0 12,1A2.5,2.5 0 0,0 9.5,3.5C9.5,3.56 9.5,3.63 9.5,3.69C9.12,3.41 8.63,3.25 8.1,3.25A2.5,2.5 0 0,0 5.6,5.75C5.6,6.74 6.19,7.6 7.03,8C6.19,8.4 5.6,9.25 5.6,10.25M12,22A9,9 0 0,0 21,13C16,13 12,17 12,22Z"/>
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-headline-md text-headline-sm text-on-surface dark:text-dark-on-background mb-1">
                                Flores de temporada:</h3>
                            <p class="font-body-md text-body-md text-on-surface-variant dark:text-dark-on-surface-variant leading-relaxed">
                                Cada ramo es una creación floral de autor, irrepetible, donde las variedades y los
                                colores evolucionan con las estaciones.</p>
                        </div>
                    </div>

                    <!-- Condición 2: Pausa -->
                    <div class="flex items-start gap-space-4">
                        <div class="flex-shrink-0 w-14 h-14 rounded-full bg-surface-container-low dark:bg-dark-surface-container-low flex items-center justify-center text-primary border border-outline-variant/30 dark:border-dark-surface-variant shadow-sm">
                            <svg class="w-7 h-7 text-primary" fill="currentColor" xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24">
                                <path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zM9 14H7v-2h2v2zm4 0h-2v-2h2v2zm4 0h-2v-2h2v2zm-8 4H7v-2h2v2zm4 0h-2v-2h2v2zm4 0h-2v-2h2v2z"/>
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-headline-md text-headline-sm text-on-surface dark:text-dark-on-background mb-1">
                                Pausa:</h3>
                            <p class="font-body-md text-body-md text-on-surface-variant dark:text-dark-on-surface-variant leading-relaxed">
                                Puedes pausar o cancelar tu suscripción cuando lo necesites, con un aviso de al menos 48
                                horas antes de tu próxima entrega programada.</p>
                        </div>
                    </div>

                    <!-- Condición 3: Entrega -->
                    <div class="flex items-start gap-space-4">
                        <div class="flex-shrink-0 w-14 h-14 rounded-full bg-surface-container-low dark:bg-dark-surface-container-low flex items-center justify-center text-primary border border-outline-variant/30 dark:border-dark-surface-variant shadow-sm">
                            <svg class="w-7 h-7 text-primary" fill="currentColor" xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24">
                                <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-headline-md text-headline-sm text-on-surface dark:text-dark-on-background mb-1">
                                Entrega:</h3>
                            <p class="font-body-md text-body-md text-on-surface-variant dark:text-dark-on-surface-variant leading-relaxed">
                                Cada miércoles, o cada quince días, te enviaremos un nuevo ramo de flores frescas de
                                temporada. (Se consideran 4 miércoles por mes)</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Columna Derecha: Zonas de Envío (Mapa) -->
            <div class="flex flex-col">
                <div class="mb-space-6 group cursor-default">
                    <h2 class="font-headline-lg text-headline-md lg:text-headline-lg text-on-surface dark:text-dark-on-background mb-2">
                        Zonas de Envío</h2>
                    <div class="w-24 h-[1.5px] bg-primary/40 transition-all duration-500 group-hover:w-32"></div>
                </div>
                <a href="https://maps.app.goo.gl/QNm6ycWU6qznkFZR7" target="_blank" rel="noopener noreferrer"
                   class="relative block w-full rounded-xl overflow-hidden shadow-md hover:shadow-lg transition-all duration-300 border border-outline-variant/30 dark:border-dark-surface-variant group aspect-video bg-surface-container-low">
                    <img src="/images/suscripcion/mapa.webp"
                         alt="Mapa estilizado de zona de envío de suscripción floral" width="1069" height="1072"
                         loading="lazy"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"/>
                    <div class="absolute bottom-4 left-4 flex items-center gap-2 bg-surface/90 dark:bg-dark-background/90 backdrop-blur-sm px-3 py-1.5 rounded-full shadow-md border border-outline-variant/20 dark:border-dark-surface-variant">
                        <svg class="w-4 h-4 text-primary flex-shrink-0" fill="currentColor"
                             xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                        </svg>
                        <span class="font-label-sm text-label-sm text-on-surface dark:text-dark-on-background font-semibold">La Jardinera</span>
                    </div>
                </a>
            </div>
        </div>
    </section>

    <!-- 3. SECCIÓN DE PLANES DE SUSCRIPCIÓN (siempre visible) -->
    <section id="planes" class="scroll-mt-24 w-full" aria-labelledby="planes-title">
        <div class="max-w-[80rem] mx-auto py-space-8 px-margin-mobile lg:px-margin-desktop">
            <div class="text-center mb-space-8">
                <div class="flex items-center justify-center gap-2 mb-2">
                    <span class="w-8 h-[1px] bg-primary/40"></span>
                    <span class="font-headline-sm text-headline-sm italic text-secondary">✦</span>
                    <span class="w-8 h-[1px] bg-primary/40"></span>
                </div>
                <h2 id="planes-title"
                    class="font-headline-xl text-headline-lg lg:text-headline-xl text-on-surface dark:text-dark-on-background mb-2">
                    Elige tu Plan de Suscripción</h2>
                <p class="font-body-md text-body-md text-on-surface-variant dark:text-dark-on-surface-variant max-w-xl mx-auto">
                    Selecciona la experiencia floral que mejor se adapte a ti o para regalar un detalle inolvidable.</p>
            </div>

            <!-- Grilla de Tarjetas de Precios (la tarjeta destacada se eleva desde md) -->
            <div id="plans-grid"
                 class="grid grid-cols-1 md:grid-cols-3 gap-space-6 md:gap-space-4 lg:gap-space-6 items-stretch md:pt-space-3">

                <!-- TARJETA 1: PLAN ESENCIAL -->
                <article
                        class="plan-card group relative flex flex-col bg-surface dark:bg-dark-surface-container-low rounded-xl shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1 border border-outline-variant/30 dark:border-dark-surface-variant overflow-hidden">
                    <div class="w-full aspect-[4/3] overflow-hidden bg-surface-container-low">
                        <img src="/images/suscripcion/plan-esencial.webp"
                             alt="Ramo del Plan Esencial de suscripción floral"
                             width="720" height="1280"
                             loading="lazy"
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"/>
                    </div>
                    <div class="p-space-4 lg:p-space-6 flex flex-col flex-grow">
                        <span class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant dark:text-dark-on-surface-variant">Plan</span>
                        <h3 class="font-headline-md text-headline-md text-on-surface dark:text-dark-on-background">
                            Esencial</h3>
                        <p class="flex items-baseline gap-1 mt-space-2 pb-space-3 border-b border-outline-variant/30 dark:border-dark-surface-variant">
                            <span class="font-headline-lg text-headline-lg text-primary dark:text-primary-fixed font-semibold">$15.000</span>
                            <span class="font-body-sm text-body-sm text-on-surface-variant dark:text-dark-on-surface-variant">/mes</span>
                        </p>
                        <ul class="space-y-space-2 text-on-surface-variant dark:text-dark-on-surface-variant font-body-sm text-body-sm my-space-3 flex-grow">
                            <li class="flex items-start gap-space-2">
                                <span class="mt-px w-5 h-5 shrink-0 rounded-full bg-primary/10 flex items-center justify-center text-primary"
                                      aria-hidden="true">
                                    <svg class="w-3.5 h-3.5" fill="currentColor" xmlns="http://www.w3.org/2000/svg"
                                         viewBox="0 0 24 24"><path
                                            d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                                </span>
                                <span>Ramo de temporada mediano</span>
                            </li>
                            <li class="flex items-start gap-space-2">
                                <span class="mt-px w-5 h-5 shrink-0 rounded-full bg-primary/10 flex items-center justify-center text-primary"
                                      aria-hidden="true">
                                    <svg class="w-3.5 h-3.5" fill="currentColor" xmlns="http://www.w3.org/2000/svg"
                                         viewBox="0 0 24 24"><path
                                            d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                                </span>
                                <span>Entrega quincenal</span>
                            </li>
                            <li class="flex items-start gap-space-2">
                                <span class="mt-px w-5 h-5 shrink-0 rounded-full bg-primary/10 flex items-center justify-center text-primary"
                                      aria-hidden="true">
                                    <svg class="w-3.5 h-3.5" fill="currentColor" xmlns="http://www.w3.org/2000/svg"
                                         viewBox="0 0 24 24"><path
                                            d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                                </span>
                                <span>Guía de cuidados básicos</span>
                            </li>
                        </ul>
                        <a href="/contacto?service=Plan%20Esencial"
                           class="mt-auto w-full inline-flex items-center justify-center gap-space-1 font-label-md text-label-md uppercase tracking-wider font-semibold text-primary border border-primary/40 hover:bg-primary/10 transition-colors px-space-4 py-3 rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
                            Seleccionar Plan
                        </a>
                    </div>
                </article>

                <!-- TARJETA 2: PLAN PREMIERE (DESTACADA · MÁS POPULAR) -->
                <article
                        class="plan-card group relative z-10 flex flex-col bg-surface dark:bg-dark-surface-container-low rounded-xl shadow-xl hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 ring-2 ring-primary overflow-hidden md:-mt-space-3 md:mb-space-3">
                    <div class="relative w-full aspect-[4/3] overflow-hidden bg-surface-container-low">
                        <img src="/images/suscripcion/plan-premiere.webp"
                             alt="Arreglo floral del Plan Premiere de suscripción floral"
                             width="720" height="1280"
                             loading="lazy"
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"/>
                        <!-- Insignia sobre la foto: par estático (fondo y texto fijos en ambos temas) -->
                        <span class="absolute top-space-2 left-space-2 inline-flex items-center gap-1.5 bg-primary-brand text-neutral-50 font-label-sm text-label-sm uppercase tracking-widest font-semibold px-3 py-1.5 rounded-full shadow-md">
                            <svg class="w-3.5 h-3.5" fill="currentColor" xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24" aria-hidden="true"><path
                                    d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                            Más popular
                        </span>
                    </div>
                    <div class="p-space-4 lg:p-space-6 flex flex-col flex-grow bg-primary/5">
                        <span class="font-label-sm text-label-sm uppercase tracking-widest text-primary font-semibold">Recomendado</span>
                        <h3 class="font-headline-md text-headline-md text-on-surface dark:text-dark-on-background">
                            Premiere</h3>
                        <p class="flex items-baseline gap-1 mt-space-2 pb-space-3 border-b border-primary/20">
                            <span class="font-headline-lg text-headline-lg text-primary dark:text-primary-fixed font-semibold">$30.000</span>
                            <span class="font-body-sm text-body-sm text-on-surface-variant dark:text-dark-on-surface-variant">/mes</span>
                        </p>
                        <ul class="space-y-space-2 text-on-surface dark:text-dark-on-background font-body-sm text-body-sm my-space-3 flex-grow">
                            <li class="flex items-start gap-space-2">
                                <span class="mt-px w-5 h-5 shrink-0 rounded-full bg-primary/20 flex items-center justify-center text-primary"
                                      aria-hidden="true">
                                    <svg class="w-3.5 h-3.5" fill="currentColor" xmlns="http://www.w3.org/2000/svg"
                                         viewBox="0 0 24 24"><path
                                            d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                                </span>
                                <span>Ramo de autor grande</span>
                            </li>
                            <li class="flex items-start gap-space-2">
                                <span class="mt-px w-5 h-5 shrink-0 rounded-full bg-primary/20 flex items-center justify-center text-primary"
                                      aria-hidden="true">
                                    <svg class="w-3.5 h-3.5" fill="currentColor" xmlns="http://www.w3.org/2000/svg"
                                         viewBox="0 0 24 24"><path
                                            d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                                </span>
                                <span>Entrega semanal</span>
                            </li>
                            <li class="flex items-start gap-space-2">
                                <span class="mt-px w-5 h-5 shrink-0 rounded-full bg-primary/20 flex items-center justify-center text-primary"
                                      aria-hidden="true">
                                    <svg class="w-3.5 h-3.5" fill="currentColor" xmlns="http://www.w3.org/2000/svg"
                                         viewBox="0 0 24 24"><path
                                            d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                                </span>
                                <span>Florero de diseño de regalo (1ra entrega)</span>
                            </li>
                            <li class="flex items-start gap-space-2">
                                <span class="mt-px w-5 h-5 shrink-0 rounded-full bg-primary/20 flex items-center justify-center text-primary"
                                      aria-hidden="true">
                                    <svg class="w-3.5 h-3.5" fill="currentColor" xmlns="http://www.w3.org/2000/svg"
                                         viewBox="0 0 24 24"><path
                                            d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                                </span>
                                <span>Acceso a flores premium</span>
                            </li>
                        </ul>
                        <a href="/contacto?service=Plan%20Premiere"
                           class="mt-auto w-full inline-flex items-center justify-center gap-space-1 font-label-md text-label-md uppercase tracking-wider font-semibold text-white dark:text-neutral-950 bg-primary hover:bg-primary/90 transition-colors px-space-4 py-3 rounded-lg shadow-md group/cta focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-primary">
                            Seleccionar Plan
                            <svg class="w-4 h-4 transition-transform group-hover/cta:translate-x-1" fill="currentColor"
                                 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/>
                            </svg>
                        </a>
                    </div>
                </article>

                <!-- TARJETA 3: PLAN LUXE -->
                <article
                        class="plan-card group relative flex flex-col bg-surface dark:bg-dark-surface-container-low rounded-xl shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1 border border-outline-variant/30 dark:border-dark-surface-variant overflow-hidden">
                    <div class="w-full aspect-[4/3] overflow-hidden bg-surface-container-low">
                        <img src="/images/suscripcion/plan-luxe.webp"
                             alt="Ramo grande y exuberante del Plan Luxe de suscripción floral"
                             width="1440" height="1621"
                             loading="lazy"
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"/>
                    </div>
                    <div class="p-space-4 lg:p-space-6 flex flex-col flex-grow">
                        <span class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant dark:text-dark-on-surface-variant">Plan</span>
                        <h3 class="font-headline-md text-headline-md text-on-surface dark:text-dark-on-background">
                            Luxe</h3>
                        <p class="flex items-baseline gap-1 mt-space-2 pb-space-3 border-b border-outline-variant/30 dark:border-dark-surface-variant">
                            <span class="font-headline-lg text-headline-lg text-primary dark:text-primary-fixed font-semibold">$45.000</span>
                            <span class="font-body-sm text-body-sm text-on-surface-variant dark:text-dark-on-surface-variant">/mes</span>
                        </p>
                        <ul class="space-y-space-2 text-on-surface-variant dark:text-dark-on-surface-variant font-body-sm text-body-sm my-space-3 flex-grow">
                            <li class="flex items-start gap-space-2">

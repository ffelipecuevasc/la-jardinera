---
import BaseLayout from '../layouts/BaseLayout.astro';
import FranjaBeneficios from '../components/secciones/FranjaBeneficios.astro';
---

<BaseLayout
    title="Galería Editorial - La Jardinera Florería"
    bodyClass="bg-background font-body-md text-body-md text-on-surface selection:bg-primary/20 selection:text-primary"
    paginaActiva="galeria"
>
<main class="w-full pt-20 bg-background min-h-screen flex flex-col flex-grow">

    <!-- 0. HERO EDITORIAL: GRAN APERTURA COFFEE TABLE BOOK -->
    <section class="w-full border-b border-outline-variant/30 py-space-8 lg:py-space-10 bg-surface">
        <div class="max-w-[80rem] mx-auto px-margin-mobile lg:px-margin-desktop flex flex-col items-center text-center">
            <!-- Rombo Floral Artesanal -->
            <div class="flex items-center justify-center gap-2 mb-space-2" aria-hidden="true">
                <span class="w-8 h-[1px] bg-primary/40"></span>
                <span class="font-headline-sm text-headline-sm italic text-secondary">✦</span>
                <span class="w-8 h-[1px] bg-primary/40"></span>
            </div>
            <span class="font-label-md text-label-md uppercase tracking-[0.2em] text-primary mb-2 block">
                Registro fotográfico de nuestro trabajo
            </span>
            <h1 class="font-headline-xl text-headline-lg lg:text-headline-xl text-on-surface tracking-tight max-w-3xl mb-space-3">
                Galería de <span class="italic text-primary">Imágenes</span>
            </h1>
            <p class="font-body-md text-body-md lg:font-body-lg lg:text-body-lg text-on-surface-variant font-light max-w-2xl leading-relaxed">
                Una exposición visual de nuestros trabajos más representativos. Cada entrega responde a la arquitectura natural de la flor, su temporalidad en el sur de Chile y el diálogo armónico con el espacio que habita.
            </p>
        </div>
    </section>

    <!-- CAPÍTULO 01: SUSCRIPCIÓN FLORAL (Superficie: Canvas Claro) -->
    <section id="suscripcion-floral" class="w-full py-space-8 lg:py-space-10 border-b border-outline-variant/20 bg-background">
        <div class="max-w-[80rem] mx-auto px-margin-mobile lg:px-margin-desktop">
            <!-- Encabezado Asimétrico de Capítulo -->
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-space-6 gap-space-3">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="font-headline-sm text-headline-sm italic text-primary font-semibold">01</span>
                        <span class="w-6 h-[1px] bg-primary/40"></span>
                        <span class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant">Colección Residencial</span>
                    </div>
                    <h2 class="font-headline-lg text-headline-md lg:text-headline-lg text-on-surface font-normal tracking-tight">
                        Suscripción Floral
                    </h2>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant max-w-md font-light leading-relaxed">
                    Flores de corte semanal que evolucionan día a día en el hogar. La belleza concebida como un hábito sereno y constante.
                </p>
            </div>

            <!-- Carrusel Expansible -->
            <div class="flex w-full space-x-2 md:space-x-4 overflow-x-auto md:overflow-visible snap-x snap-mandatory md:snap-none hide-scrollbar scroll-smooth">
                <button type="button" class="gallery-carousel-card group relative h-[320px] md:h-[420px] flex-1 hover:grow-[10] focus-visible:grow-[10] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition-all duration-700 ease-in-out cursor-pointer flex-shrink-0 w-[80vw] md:w-auto snap-center rounded-xl overflow-hidden shadow-sm" data-type="image" data-src="/images/galeria/sf1.webp" aria-label="Ampliar Ramo de flores frescas para Suscripción floral">
                    <img src="/images/galeria/sf1.webp" alt="Ramo de flores frescas para Suscripción floral" loading="lazy" class="w-full h-full object-cover rounded-xl transition-transform duration-700 ease-out" />
                    <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-xl pointer-events-none" aria-hidden="true">
                        <svg class="w-12 h-12 text-white" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/>
                        </svg>
                    </div>
                </button>
                <button type="button" class="gallery-carousel-card group relative h-[320px] md:h-[420px] flex-1 hover:grow-[10] focus-visible:grow-[10] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition-all duration-700 ease-in-out cursor-pointer flex-shrink-0 w-[80vw] md:w-auto snap-center rounded-xl overflow-hidden shadow-sm" data-type="image" data-src="/images/galeria/sf2.webp" aria-label="Ampliar Arreglo floral de temporada para Suscripción floral">
                    <img src="/images/galeria/sf2.webp" alt="Arreglo floral de temporada para Suscripción floral" loading="lazy" class="w-full h-full object-cover rounded-xl transition-transform duration-700 ease-out" />
                    <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-xl pointer-events-none" aria-hidden="true">
                        <svg class="w-12 h-12 text-white" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/>
                        </svg>
                    </div>
                </button>
                <button type="button" class="gallery-carousel-card group relative h-[320px] md:h-[420px] flex-1 hover:grow-[10] focus-visible:grow-[10] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition-all duration-700 ease-in-out cursor-pointer flex-shrink-0 w-[80vw] md:w-auto snap-center rounded-xl overflow-hidden shadow-sm" data-type="video" data-src="/images/galeria/sf3.mp4" aria-label="Ampliar Video demostrativo de Suscripción floral">
                    <video src="/images/galeria/sf3.mp4" autoplay loop muted playsinline class="w-full h-full object-cover rounded-xl transition-transform duration-700 ease-out"></video>
                    <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-xl pointer-events-none" aria-hidden="true">
                        <svg class="w-12 h-12 text-white" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/>
                        </svg>
                    </div>
                </button>
                <button type="button" class="gallery-carousel-card group relative h-[320px] md:h-[420px] flex-1 hover:grow-[10] focus-visible:grow-[10] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition-all duration-700 ease-in-out cursor-pointer flex-shrink-0 w-[80vw] md:w-auto snap-center rounded-xl overflow-hidden shadow-sm" data-type="image" data-src="/images/galeria/sf5.webp" aria-label="Ampliar Flores frescas de autor para Suscripción floral">
                    <img src="/images/galeria/sf5.webp" alt="Flores frescas de autor para Suscripción floral" loading="lazy" class="w-full h-full object-cover rounded-xl transition-transform duration-700 ease-out" />
                    <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-xl pointer-events-none" aria-hidden="true">
                        <svg class="w-12 h-12 text-white" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/>
                        </svg>
                    </div>
                </button>
                <button type="button" class="gallery-carousel-card group relative h-[320px] md:h-[420px] flex-1 hover:grow-[10] focus-visible:grow-[10] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition-all duration-700 ease-in-out cursor-pointer flex-shrink-0 w-[80vw] md:w-auto snap-center rounded-xl overflow-hidden shadow-sm" data-type="video" data-src="/images/galeria/sf6.mp4" aria-label="Ampliar Video de preparación de Suscripción floral">
                    <video src="/images/galeria/sf6.mp4" autoplay loop muted playsinline class="w-full h-full object-cover rounded-xl transition-transform duration-700 ease-out"></video>
                    <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-xl pointer-events-none" aria-hidden="true">
                        <svg class="w-12 h-12 text-white" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/>
                        </svg>
                    </div>
                </button>
                <button type="button" class="gallery-carousel-card group relative h-[320px] md:h-[420px] flex-1 hover:grow-[10] focus-visible:grow-[10] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition-all duration-700 ease-in-out cursor-pointer flex-shrink-0 w-[80vw] md:w-auto snap-center rounded-xl overflow-hidden shadow-sm" data-type="image" data-src="/images/galeria/sf7.webp" aria-label="Ampliar Composición floral elegante para Suscripción floral">
                    <img src="/images/galeria/sf7.webp" alt="Composición floral elegante para Suscripción floral" loading="lazy" class="w-full h-full object-cover rounded-xl transition-transform duration-700 ease-out" />
                    <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-xl pointer-events-none" aria-hidden="true">
                        <svg class="w-12 h-12 text-white" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/>
                        </svg>
                    </div>
                </button>
                <button type="button" class="gallery-carousel-card group relative h-[320px] md:h-[420px] flex-1 hover:grow-[10] focus-visible:grow-[10] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition-all duration-700 ease-in-out cursor-pointer flex-shrink-0 w-[80vw] md:w-auto snap-center rounded-xl overflow-hidden shadow-sm" data-type="video" data-src="/images/galeria/sfv.mp4" aria-label="Ampliar Video de entrega de Suscripción floral">
                    <video src="/images/galeria/sfv.mp4" autoplay loop muted playsinline class="w-full h-full object-cover rounded-xl transition-transform duration-700 ease-out"></video>
                    <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-xl pointer-events-none" aria-hidden="true">
                        <svg class="w-12 h-12 text-white" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/>
                        </svg>
                    </div>
                </button>
            </div>
        </div>
    </section>

    <!-- CAPÍTULO 02: GIFT CARDS (Superficie: Neutro Cálido Elevado) -->
    <section id="gift-cards" class="w-full py-space-8 lg:py-space-10 border-b border-outline-variant/20 bg-surface-container-low">
        <div class="max-w-[80rem] mx-auto px-margin-mobile lg:px-margin-desktop">
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-space-6 gap-space-3">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="font-headline-sm text-headline-sm italic text-secondary font-semibold">02</span>
                        <span class="w-6 h-[1px] bg-secondary/40"></span>
                        <span class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant">Gestos &amp; Recuerdos</span>
                    </div>
                    <h2 class="font-headline-lg text-headline-md lg:text-headline-lg text-on-surface font-normal tracking-tight">
                        Gift Cards
                    </h2>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant max-w-md font-light leading-relaxed">
                    Experiencias que trascienden el momento de recibirlas: la posibilidad de elegir tiempo, presencia y color.
                </p>
            </div>

            <!-- Carrusel Expansible -->
            <div class="flex w-full space-x-2 md:space-x-4 overflow-x-auto md:overflow-visible snap-x snap-mandatory md:snap-none hide-scrollbar scroll-smooth">
                <button type="button" class="gallery-carousel-card group relative h-[320px] md:h-[420px] flex-1 hover:grow-[10] focus-visible:grow-[10] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition-all duration-700 ease-in-out cursor-pointer flex-shrink-0 w-[80vw] md:w-auto snap-center rounded-xl overflow-hidden shadow-sm" data-type="image" data-src="/images/galeria/gcf1.webp" aria-label="Ampliar Gift Card física y digital para obsequios florales">
                    <img src="/images/galeria/gcf1.webp" alt="Gift Card física y digital para obsequios florales" loading="lazy" class="w-full h-full object-cover rounded-xl transition-transform duration-700 ease-out" />
                    <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-xl pointer-events-none" aria-hidden="true">
                        <svg class="w-12 h-12 text-white" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/>
                        </svg>
                    </div>
                </button>
                <button type="button" class="gallery-carousel-card group relative h-[320px] md:h-[420px] flex-1 hover:grow-[10] focus-visible:grow-[10] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition-all duration-700 ease-in-out cursor-pointer flex-shrink-0 w-[80vw] md:w-auto snap-center rounded-xl overflow-hidden shadow-sm" data-type="video" data-src="/images/galeria/gcf2.mp4" aria-label="Ampliar Presentación en video de Gift Cards">
                    <video src="/images/galeria/gcf2.mp4" autoplay loop muted playsinline class="w-full h-full object-cover rounded-xl transition-transform duration-700 ease-out"></video>
                    <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-xl pointer-events-none" aria-hidden="true">
                        <svg class="w-12 h-12 text-white" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/>
                        </svg>
                    </div>
                </button>
            </div>
        </div>
    </section>

    <!-- CAPÍTULO 03: DECORACIÓN DE MESAS (Superficie: Canvas Claro) -->
    <section id="decoracion-mesas" class="w-full py-space-8 lg:py-space-10 border-b border-outline-variant/20 bg-background">
        <div class="max-w-[80rem] mx-auto px-margin-mobile lg:px-margin-desktop">
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-space-6 gap-space-3">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="font-headline-sm text-headline-sm italic text-primary font-semibold">03</span>
                        <span class="w-6 h-[1px] bg-primary/40"></span>
                        <span class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant">Escenografía Botánica</span>
                    </div>
                    <h2 class="font-headline-lg text-headline-md lg:text-headline-lg text-on-surface font-normal tracking-tight">
                        Decoración de Mesas
                    </h2>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant max-w-md font-light leading-relaxed">
                    Composiciones asimétricas, gres cerámico y flores de estación dispuestas para acompañar celebraciones y conversaciones íntimas.
                </p>
            </div>

            <!-- Carrusel Expansible -->
            <div class="flex w-full space-x-2 md:space-x-4 overflow-x-auto md:overflow-visible snap-x snap-mandatory md:snap-none hide-scrollbar scroll-smooth">
                <button type="button" class="gallery-carousel-card group relative h-[320px] md:h-[420px] flex-1 hover:grow-[10] focus-visible:grow-[10] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition-all duration-700 ease-in-out cursor-pointer flex-shrink-0 w-[80vw] md:w-auto snap-center rounded-xl overflow-hidden shadow-sm" data-type="image" data-src="/images/galeria/ddm1.webp" aria-label="Ampliar Centro de mesa floral con arreglos de autor">
                    <img src="/images/galeria/ddm1.webp" alt="Centro de mesa floral con arreglos de autor" loading="lazy" class="w-full h-full object-cover rounded-xl transition-transform duration-700 ease-out" />
                    <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-xl pointer-events-none" aria-hidden="true">
                        <svg class="w-12 h-12 text-white" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/>
                        </svg>
                    </div>
                </button>
                <button type="button" class="gallery-carousel-card group relative h-[320px] md:h-[420px] flex-1 hover:grow-[10] focus-visible:grow-[10] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition-all duration-700 ease-in-out cursor-pointer flex-shrink-0 w-[80vw] md:w-auto snap-center rounded-xl overflow-hidden shadow-sm" data-type="video" data-src="/images/galeria/ddm2.mp4" aria-label="Ampliar Video de montaje para Decoración de Mesas">
                    <video src="/images/galeria/ddm2.mp4" autoplay loop muted playsinline class="w-full h-full object-cover rounded-xl transition-transform duration-700 ease-out"></video>
                    <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-xl pointer-events-none" aria-hidden="true">
                        <svg class="w-12 h-12 text-white" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/>
                        </svg>
                    </div>
                </button>
                <button type="button" class="gallery-carousel-card group relative h-[320px] md:h-[420px] flex-1 hover:grow-[10] focus-visible:grow-[10] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition-all duration-700 ease-in-out cursor-pointer flex-shrink-0 w-[80vw] md:w-auto snap-center rounded-xl overflow-hidden shadow-sm" data-type="image" data-src="/images/galeria/ddm3.webp" aria-label="Ampliar Detalle de ambientación floral para mesa principal">
                    <img src="/images/galeria/ddm3.webp" alt="Detalle de ambientación floral para mesa principal" loading="lazy" class="w-full h-full object-cover rounded-xl transition-transform duration-700 ease-out" />
                    <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-xl pointer-events-none" aria-hidden="true">
                        <svg class="w-12 h-12 text-white" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/>
                        </svg>
                    </div>
                </button>
                <button type="button" class="gallery-carousel-card group relative h-[320px] md:h-[420px] flex-1 hover:grow-[10] focus-visible:grow-[10] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition-all duration-700 ease-in-out cursor-pointer flex-shrink-0 w-[80vw] md:w-auto snap-center rounded-xl overflow-hidden shadow-sm" data-type="image" data-src="/images/galeria/ddm4.webp" aria-label="Ampliar Composición floral para mesa de comedor">
                    <img src="/images/galeria/ddm4.webp" alt="Composición floral para mesa de comedor" loading="lazy" class="w-full h-full object-cover rounded-xl transition-transform duration-700 ease-out" />
                    <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-xl pointer-events-none" aria-hidden="true">
                        <svg class="w-12 h-12 text-white" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/>
                        </svg>
                    </div>
                </button>
                <button type="button" class="gallery-carousel-card group relative h-[320px] md:h-[420px] flex-1 hover:grow-[10] focus-visible:grow-[10] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition-all duration-700 ease-in-out cursor-pointer flex-shrink-0 w-[80vw] md:w-auto snap-center rounded-xl overflow-hidden shadow-sm" data-type="image" data-src="/images/galeria/ddm5.webp" aria-label="Ampliar Decoración floral integral para eventos">
                    <img src="/images/galeria/ddm5.webp" alt="Decoración floral integral para eventos" loading="lazy" class="w-full h-full object-cover rounded-xl transition-transform duration-700 ease-out" />
                    <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-xl pointer-events-none" aria-hidden="true">
                        <svg class="w-12 h-12 text-white" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/>
                        </svg>
                    </div>
                </button>
            </div>
        </div>
    </section>

    <!-- CAPÍTULO 04: RAMOS DE NOVIA (Superficie: Neutro Cálido Elevado) -->
    <section id="ramos-de-novia" class="w-full py-space-8 lg:py-space-10 border-b border-outline-variant/20 bg-surface-container-low">
        <div class="max-w-[80rem] mx-auto px-margin-mobile lg:px-margin-desktop">
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-space-6 gap-space-3">
                <div>
                    <div class="flex items-center gap-2 mb-1">

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="Página no encontrada - La Jardinera Florería"
    description="La página que buscas no existe o ha sido movida. Regresa al inicio de La Jardinera Florería en Valdivia."
    noindex
    bodyClass="bg-background font-body-md text-body-md text-on-surface flex flex-col min-h-screen"
    paginaActiva={null}
>
<!-- SECCIÓN CENTRAL DE ERROR 404 -->
<main class="w-full pt-20 flex-grow bg-background flex flex-col items-center justify-center min-h-[80vh] py-space-10">
    <div class="max-w-2xl mx-auto px-margin-mobile text-center">

        <!-- Separador Editorial con Rombo (✦) -->
        <div class="flex items-center justify-center gap-2 mb-space-2" aria-hidden="true">
            <span class="w-8 h-[1px] bg-primary/40"></span>
            <span class="font-headline-sm text-headline-sm italic text-secondary">✦</span>
            <span class="w-8 h-[1px] bg-primary/40"></span>
        </div>

        <!-- Código de Error 404 -->
        <p class="font-display-hero text-headline-xl lg:text-display-hero text-primary font-normal leading-none mb-space-2">
            404
        </p>

        <!-- Título H1 -->
        <h1 class="font-headline-xl text-headline-lg lg:text-headline-xl text-on-surface dark:text-dark-on-background mb-space-3">
            Esta flor no florece aquí
        </h1>

        <!-- Párrafo Descriptivo -->
        <p class="font-body-md text-body-md text-on-surface-variant dark:text-dark-on-surface-variant max-w-md mx-auto mb-space-6 leading-relaxed">
            El enlace que seguiste no existe o ha cambiado de lugar. Te invitamos a volver al jardín principal para seguir explorando.
        </p>

        <!-- Botón CTA de Recuperación -->
        <a href="/"
           class="inline-flex items-center justify-center px-space-6 py-3.5 rounded-lg bg-primary text-neutral-50 font-label-lg uppercase tracking-wider hover:opacity-90 transition-all shadow-md gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
            <svg class="w-5 h-5" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
            </svg>
            <span>Volver al Inicio</span>
        </a>

    </div>
</main>
</BaseLayout>

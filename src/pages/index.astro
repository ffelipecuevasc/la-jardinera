---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="La Jardinera Florería - Valdivia, Chile"
    bodyClass="bg-background font-body-md text-body-md text-on-surface"
    paginaActiva="inicio"
>
<main class="w-full pt-20 bg-background min-h-screen">
    <div class="flex flex-col w-full">
        <!-- 1. HERO SECTION -->
        <section id="titular"
                 class="relative w-full -mt-20 overflow-hidden bg-dark-background text-dark-on-background min-h-[92vh] flex items-center justify-center">
            <!-- Carrusel de fotografías a pleno color (ADR-004): sin scrims, sin opacidad, sin escala.
                 Las fotos 2 a 4 parten con «hidden» y loading="lazy": no se descargan hasta que
                 hero-carousel.js las muestra después del evento load (nunca con movimiento reducido). -->
            <picture class="hero-slide is-active absolute inset-0">
                <source media="(orientation: portrait)"
                        srcset="/images/inicio/hero-01-mobile.webp"
                        type="image/webp" width="1536" height="2752">
                <img src="/images/inicio/hero-01-desktop.webp"
                     alt="Manos de florista envolviendo en papel kraft un ramo de rosas fucsia, gerberas, claveles y alstroemerias"
                     width="2752" height="1536"
                     fetchpriority="high" decoding="async"
                     class="w-full h-full object-cover">
            </picture>
            <picture class="hero-slide absolute inset-0" hidden>
                <source media="(orientation: portrait)"
                        srcset="/images/inicio/hero-02-mobile.webp"
                        type="image/webp" width="864" height="1536">
                <img src="/images/inicio/hero-02-desktop.webp"
                     alt="Salón de eventos ambientado con faroles, lámparas de mimbre colgantes y arreglos de paniculata y follaje sobre una mesa de madera"
                     width="2752" height="1536"
                     loading="lazy" decoding="async"
                     class="w-full h-full object-cover">
            </picture>
            <picture class="hero-slide absolute inset-0" hidden>
                <source media="(orientation: portrait)"
                        srcset="/images/inicio/hero-03-mobile.webp"
                        type="image/webp" width="1536" height="2752">
                <img src="/images/inicio/hero-03-desktop.webp"
                     alt="Mesa de madera blanca con arreglos de gerberas, rosas, alstroemerias y claveles de colores vivos en un salón con luces cálidas"
                     width="2752" height="1536"
                     loading="lazy" decoding="async"
                     class="w-full h-full object-cover">
            </picture>
            <picture class="hero-slide absolute inset-0" hidden>
                <source media="(orientation: portrait)"
                        srcset="/images/inicio/hero-04-mobile.webp"
                        type="image/webp" width="864" height="1536">
                <img src="/images/inicio/hero-04-desktop.webp"
                     alt="Florista sonriente armando un ramo en su taller, rodeada de flores frescas"
                     width="2752" height="1536"
                     loading="lazy" decoding="async"
                     class="w-full h-full object-cover">
            </picture>
            <!-- Contenedor de la tarjeta (libera el header fijo con pt-24) -->
            <div class="relative z-10 w-full max-w-4xl mx-auto px-margin-mobile lg:px-margin-desktop pt-24 pb-space-8">
                <!-- Tarjeta de vidrio -->
                <div class="hero-glass flex flex-col items-center text-center gap-space-3 p-space-4 md:p-space-8 rounded-3xl border border-white/20 bg-dark-background/60 backdrop-blur-xl backdrop-saturate-150 shadow-2xl">
                    <!-- Headline -->
                    <h1 class="font-display-hero text-headline-xl-mobile md:text-headline-xl md:leading-none lg:text-display-hero text-neutral-50 font-semibold md:font-semibold lg:font-semibold max-w-4xl tracking-tight">
                        <span class="fx-starlight">Florería <span class="fx-starlight fx-starlight--accent italic font-normal">La Jardinera</span></span>
                    </h1>
                    <!-- Editorial Paragraph -->
                    <p class="font-body-md text-body-md md:font-body-lg md:text-body-lg md:leading-relaxed text-neutral-50 max-w-2xl font-light md:font-light">
                        <em>Amamos las flores, trabajar y convivir con ellas. Es increíble el efecto que generan cuando las
                            ves,
                            cuando las arreglas, cuando las recibes, cuando las regalas, cuando las dedicas.</em>
                    </p>
                    <!-- CTAs -->
                    <div class="flex flex-wrap items-center justify-center gap-space-3">
                        <a class="inline-flex items-center justify-center px-space-4 py-3 rounded-lg bg-primary-brand text-neutral-50 font-label-lg text-label-lg uppercase tracking-wider hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-fixed focus-visible:ring-offset-2 focus-visible:ring-offset-dark-background transition-all shadow-md"
                           href="#servicios">
                            <span>Explorar Servicios</span>
                            <svg class="text-[18px] ml-2" fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="24"
                                 height="24" viewBox="0 0 24 24">
                                <path d="m12 4-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8-8-8z"/>
                            </svg>
                        </a>
                        <a class="inline-flex items-center justify-center px-space-4 py-3 rounded-lg bg-dark-background/30 text-neutral-50 font-label-lg text-label-lg uppercase tracking-wider hover:bg-dark-background/45 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-fixed transition-all"
                           href="#suscripcion">
                            <span>Suscripción Floral</span>
                        </a>
                    </div>
                    <!-- Fila de datos: ubicación y desplazamiento -->
                    <div class="w-full pt-space-3 border-t border-white/20 flex flex-col md:flex-row items-center justify-between gap-space-2">
                        <div class="hidden md:flex items-center gap-space-2 text-neutral-50 font-label-sm text-label-sm tracking-widest uppercase">
                            <svg class="text-neutral-50 text-[18px]" aria-hidden="true" fill="currentColor" xmlns="http://www.w3.org/2000/svg"
                                 width="24" height="24" viewBox="0 0 24 24">
                                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-5.5-2.5 7.51-3.49L17.5 6.5 9.99 9.99 6.5 17.5zm5.5-6.6c.61 0 1.1.49 1.1 1.1s-.49 1.1-1.1 1.1-1.1-.49-1.1-1.1.49-1.1 1.1-1.1z"/>
                            </svg>
                            <span><strong>Valdivia</strong>, Región de Los Ríos, Chile</span>
                        </div>
                        <a aria-label="Desplazarse a servicios"
                           class="flex items-center min-h-11 gap-2 text-neutral-50 hover:underline underline-offset-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-fixed font-label-sm text-label-sm uppercase tracking-widest transition-colors"
                           href="#servicios">
                            <span>Descubrir Más</span>
                            <svg class="text-[16px] animate-bounce motion-reduce:animate-none" fill="currentColor" xmlns="http://www.w3.org/2000/svg"
                                 width="24" height="24" viewBox="0 0 24 24">
                                <path d="m20 12-1.41-1.41L13 16.17V4h-2v12.17l-5.58-5.59L4 12l8 8 8-8z"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
            <!-- Pausa/reanudación del carrusel (WCAG 2.2.2, D-03). Oculto hasta que hero-carousel.js
                 confirma que hay rotación: sin JS o con movimiento reducido no se muestra (D-05). -->
            <button id="hero-carousel-toggle" type="button"
                    aria-label="Pausar presentación de imágenes"
                    class="hidden absolute bottom-space-2 right-space-2 z-10 inline-flex items-center justify-center w-11 h-11 rounded-full border border-white/20 bg-dark-background/45 text-neutral-50 hover:bg-dark-background/65 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-fixed transition-colors">
                <svg class="hero-carousel-icon-pause w-6 h-6" aria-hidden="true" fill="currentColor" xmlns="http://www.w3.org/2000/svg"
                     width="24" height="24" viewBox="0 0 24 24">
                    <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                </svg>
                <svg class="hero-carousel-icon-play w-6 h-6 hidden" aria-hidden="true" fill="currentColor" xmlns="http://www.w3.org/2000/svg"
                     width="24" height="24" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                </svg>
            </button>
        </section>
        <!-- OPERATIONAL BENEFITS BAR (Upper Glance) -->
        <section class="w-full bg-surface-container-low shadow-sm">
            <div class="max-w-[80rem] mx-auto px-margin-mobile lg:px-margin-desktop py-space-3">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-space-4 items-center">
                    <!-- Benefit 1 -->
                    <div class="flex items-center gap-space-3 p-space-1">
                        <div class="w-12 h-12 rounded-full bg-surface flex items-center justify-center text-primary shadow-sm flex-shrink-0">
                            <svg class="text-[24px]" fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="24"
                                 height="24" viewBox="0 0 24 24">
                                <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zm-.5 1.5 1.96 2.5H17V9.5h2.5zM6 18c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm2.22-3c-.55-.61-1.33-1-2.22-1s-1.67.39-2.22 1H3V6h12v9H8.22zM18 18c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z"/>
                            </svg>
                        </div>
                        <div>
                            <h4 class="font-label-md text-label-md uppercase tracking-wider text-on-surface font-semibold">
                                Despacho en el Día</h4>
                            <p class="font-body-sm text-body-sm text-on-surface-variant">
                                Entregas gratuitas en todo el radio urbano de Valdivia.
                            </p>
                        </div>
                    </div>
                    <!-- Benefit 2 -->
                    <div class="flex items-center gap-space-3 p-space-1">
                        <div class="w-12 h-12 rounded-full bg-surface flex items-center justify-center text-primary shadow-sm flex-shrink-0">
                            <svg class="text-[24px]" fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="24"
                                 height="24" viewBox="0 0 24 24">
                                <path d="M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm7 10c0 4.52-2.98 8.69-7 9.93-4.02-1.24-7-5.41-7-9.93V6.3l7-3.11 7 3.11V11zm-11.59.59L6 13l4 4 8-8-1.41-1.42L10 14.17z"/>
                            </svg>
                        </div>
                        <div>
                            <h4 class="font-label-md text-label-md uppercase tracking-wider text-on-surface font-semibold">
                                Pagos Seguros &amp; Facturación</h4>
                            <p class="font-body-sm text-body-sm text-on-surface-variant">
                                Redbanc, efectivo y transferencias bancarias.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- 2. SERVICIOS DESTACADOS -->
        <section class="w-full py-space-8 lg:py-space-10" id="servicios">
            <div class="max-w-[80rem] mx-auto px-margin-mobile lg:px-margin-desktop">
                <!-- Section Header -->
                <div class="flex flex-col items-center text-center max-w-2xl mx-auto mb-space-6">
                    <div class="flex items-center justify-center gap-2 mb-2">
                        <span class="w-8 h-[1px] bg-primary/40"></span>
                        <span class="font-headline-sm text-headline-sm italic text-secondary">✦</span>
                        <span class="w-8 h-[1px] bg-primary/40"></span>
                    </div>
                    <p class="font-label-md text-label-md uppercase tracking-widest text-primary mb-1">
                        ¿En qué te ayudamos hoy?
                    </p>
                    <h2 class="font-headline-xl text-headline-lg lg:text-headline-xl text-on-surface">Nuestros
                        Servicios</h2>
                    <p class="font-body-md text-body-md text-on-surface-variant mt-space-2">
                        Cada diseño responde a una búsqueda formal: equilibrio asimétrico, texturas terrosas y flores
                        que conservan su gesto natural en el espacio.
                    </p>
                </div>
                <!-- Services Grid (4 Cards) -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-space-4">
                    <!-- Card 1: Novias -->
                    <a href="/servicios" class="group flex flex-col bg-surface rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
                        <div class="relative w-full aspect-[4/5] overflow-hidden bg-surface-container">
                            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                                 alt="Ramos de Novia"
                                 src="/images/servicio-novias.webp" loading="lazy"/>
                            <span class="absolute top-space-2 right-space-2 px-2.5 py-1 rounded-full bg-surface/90 backdrop-blur-sm font-label-sm text-label-sm uppercase tracking-wider text-on-surface">01</span>
                        </div>
                        <div class="flex flex-col p-space-3 flex-grow justify-between">
                            <div>
                                <div class="flex items-center gap-2 text-primary mb-1">
                                    <!-- Ícono de Corazón Elegante -->
                                    <svg class="text-[20px]" fill="currentColor" xmlns="http://www.w3.org/2000/svg"
                                         width="24" height="24" viewBox="0 0 24 24">
                                        <path d="M16.5 3c-1.74 0-3.41.81-4.5 2.09C10.91 3.81 9.24 3 7.5 3 4.42 3 2 5.42 2 8.5c0 3.78 3.4 6.86 8.55 11.54L12 21.35l1.45-1.32C18.6 15.36 22 12.28 22 8.5 22 5.42 19.58 3 16.5 3zm-4.4 15.55l-.1.1-.1-.1C7.14 14.24 4 11.39 4 8.5 4 6.5 5.5 5 7.5 5c1.54 0 3.04.99 3.57 2.36h1.87C13.46 5.99 14.96 5 16.5 5c2 0 3.5 1.5 3.5 3.5 0 2.89-3.14 5.74-7.9 10.05z"/>
                                    </svg>
                                    <span class="font-label-sm text-label-sm uppercase tracking-wider">Novias</span>
                                </div>
                                <h3 class="font-headline-md text-headline-sm lg:text-headline-md text-on-surface mb-2">
                                    Ramos de Novia</h3>
                                <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                                    Diseños nupciales únicos que capturan tu esencia.
                                </p>
                            </div>
                            <div class="mt-space-3 pt-space-2 flex items-center justify-between">
                                <span class="font-label-sm text-label-sm uppercase tracking-widest text-primary font-semibold">Elegancia y Color</span>
                                <svg class="text-on-surface-variant group-hover:text-primary group-hover:translate-x-1 transition-all text-[20px]"
                                     fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                     viewBox="0 0 24 24">
                                    <path d="m15 5-1.41 1.41L18.17 11H2v2h16.17l-4.59 4.59L15 19l7-7-7-7z"/>
                                </svg>
                            </div>
                        </div>
                    </a>
                    <!-- Card 2: Eventos -->
                    <a href="/servicios" class="group flex flex-col bg-surface rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
                        <div class="relative w-full aspect-[4/5] overflow-hidden bg-surface-container">
                            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                                 alt="Decoración de Eventos"
                                 src="/images/servicio-eventos.webp" loading="lazy"/>
                            <span class="absolute top-space-2 right-space-2 px-2.5 py-1 rounded-full bg-surface/90 backdrop-blur-sm font-label-sm text-label-sm uppercase tracking-wider text-on-surface">02</span>
                        </div>
                        <div class="flex flex-col p-space-3 flex-grow justify-between">
                            <div>
                                <div class="flex items-center gap-2 text-primary mb-1">
                                    <!-- Ícono de Destellos / Eventos -->
                                    <svg class="text-[20px]" fill="currentColor" xmlns="http://www.w3.org/2000/svg"
                                         width="24" height="24" viewBox="0 0 24 24">
                                        <path d="M19 9l1.25-2.75L23 5l-2.75-1.25L19 1l-1.25 2.75L15 5l2.75 1.25L19 9zm-7.5.5L9 4 6.5 9.5 1 12l5.5 2.5L9 20l2.5-5.5L17 12l-5.5-2.5zM9 14.21l-1.07-2.34L5.59 10.8l2.34-1.07L9 7.39l1.07 2.34L12.41 10.8l-2.34 1.07L9 14.21zM19 15l-1.25 2.75L15 19l2.75 1.25L19 23l1.25-2.75L23 19l-2.75-1.25L19 15z"/>
                                    </svg>
                                    <span class="font-label-sm text-label-sm uppercase tracking-wider">Eventos</span>
                                </div>
                                <h3 class="font-headline-md text-headline-sm lg:text-headline-md text-on-surface mb-2">
                                    Decoraciones</h3>
                                <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                                    Ambientación para matrimonios, cenas y diferentes eventos.
                                </p>
                            </div>
                            <div class="mt-space-3 pt-space-2 flex items-center justify-between">
                                <span class="font-label-sm text-label-sm uppercase tracking-widest text-primary font-semibold">Cotización a medida</span>
                                <svg class="text-on-surface-variant group-hover:text-primary group-hover:translate-x-1 transition-all text-[20px]"
                                     fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                     viewBox="0 0 24 24">
                                    <path d="m15 5-1.41 1.41L18.17 11H2v2h16.17l-4.59 4.59L15 19l7-7-7-7z"/>
                                </svg>
                            </div>
                        </div>
                    </a>
                    <!-- Card 3: Suscripciones -->
                    <a href="/suscripcion-floral" class="group flex flex-col bg-surface rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
                        <div class="relative w-full aspect-[4/5] overflow-hidden bg-surface-container">
                            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                                 alt="Suscripción Residencial"
                                 src="/images/servicio-suscripcion.webp" loading="lazy"/>
                            <span class="absolute top-space-2 right-space-2 px-2.5 py-1 rounded-full bg-surface/90 backdrop-blur-sm font-label-sm text-label-sm uppercase tracking-wider text-on-surface">03</span>
                        </div>
                        <div class="flex flex-col p-space-3 flex-grow justify-between">
                            <div>
                                <div class="flex items-center gap-2 text-primary mb-1">
                                    <!-- Ícono de Flor/Spa -->
                                    <svg class="text-[20px]" fill="currentColor" xmlns="http://www.w3.org/2000/svg"
                                         width="24" height="24" viewBox="0 0 24 24">
                                        <path d="M15.49 9.63c-.18-2.79-1.31-5.51-3.43-7.63a12.188 12.188 0 0 0-3.55 7.63c1.28.68 2.46 1.56 3.49 2.63 1.03-1.06 2.21-1.94 3.49-2.63zm-3.44-4.44c.63 1.03 1.07 2.18 1.3 3.38-.47.3-.91.63-1.34.98-.42-.34-.87-.67-1.33-.97.25-1.2.71-2.35 1.37-3.39zM12 15.45a12.11 12.11 0 0 0-3.06-3.2c-.13-.09-.27-.16-.4-.26.13.09.27.17.39.25A11.777 11.777 0 0 0 2 10c0 5.32 3.36 9.82 8.03 11.49.63.23 1.29.4 1.97.51.68-.12 1.33-.29 1.97-.51C18.64 19.82 22 15.32 22 10c-4.18 0-7.85 2.17-10 5.45zm1.32 4.15c-.44.15-.88.27-1.33.37-.44-.09-.87-.21-1.28-.36-3.29-1.18-5.7-3.99-6.45-7.35 1.1.26 2.15.71 3.12 1.33l-.02.01c.13.09.26.18.39.25l.07.04c.99.72 1.84 1.61 2.51 2.65L12 19.1l1.67-2.55a10.19 10.19 0 0 1 2.53-2.66l.07-.05c.09-.05.18-.11.27-.17l-.01-.02c.98-.65 2.07-1.13 3.21-1.4-.75 3.37-3.15 6.18-6.42 7.35zm-4.33-7.32c-.02-.01-.04-.03-.05-.04 0 0 .01 0 .01.01.01.01.02.02.04.03z"/>
                                    </svg>
                                    <span class="font-label-sm text-label-sm uppercase tracking-wider">Ramos</span>
                                </div>
                                <h3 class="font-headline-md text-headline-sm lg:text-headline-md text-on-surface mb-2">
                                    Suscripciones</h3>
                                <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                                    Ramos frescos y arreglos bajo suscripción con entrega directo a tu puerta.
                                </p>
                            </div>
                            <div class="mt-space-3 pt-space-2 flex items-center justify-between">
                                <span class="font-label-sm text-label-sm uppercase tracking-widest text-primary font-semibold">Semanal / Mensual</span>
                                <svg class="text-on-surface-variant group-hover:text-primary group-hover:translate-x-1 transition-all text-[20px]"
                                     fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                     viewBox="0 0 24 24">
                                    <path d="m15 5-1.41 1.41L18.17 11H2v2h16.17l-4.59 4.59L15 19l7-7-7-7z"/>
                                </svg>
                            </div>
                        </div>
                    </a>
                    <!-- Card 4: Lancha -->
                    <a href="/servicios" class="group flex flex-col bg-surface rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
                        <div class="relative w-full aspect-[4/5] overflow-hidden bg-surface-container">
                            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                                 alt="Novias MaGu"
                                 src="/images/servicio-magu.webp" loading="lazy"/>
                            <span class="absolute top-space-2 right-space-2 px-2.5 py-1 rounded-full bg-surface/90 backdrop-blur-sm font-label-sm text-label-sm uppercase tracking-wider text-on-surface">04</span>
                        </div>
                        <div class="flex flex-col p-space-3 flex-grow justify-between">
                            <div>
                                <div class="flex items-center gap-2 text-primary mb-1">
                                    <!-- Ícono de Lancha/Velero -->
                                    <svg class="text-[20px]" fill="currentColor" xmlns="http://www.w3.org/2000/svg"
                                         width="24" height="24" viewBox="0 0 24 24">
